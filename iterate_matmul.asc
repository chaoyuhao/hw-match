// Included inside local_baseline, after the existing merge and compensated Sum.
__aicore__ inline void ConsumeLocalC(AscendC::LocalTensor<float> values,
                                     AscendC::LocalTensor<float> columnMax,
                                     AscendC::LocalTensor<float> rowMax,
                                     uint32_t rows, uint32_t width, uint32_t stride)
{
    using namespace AscendC;
    // Sequential ND output uses the CURRENT tile width as its compact row
    // stride, including N tails. Host admits only 32B-aligned FP32 rows.
    // The suffix beyond rows*width is unspecified; masks never include it.
    for (uint32_t row = 0; row < rows; row += REDUCE_ROWS) {
        const uint32_t count = rows - row < REDUCE_ROWS ? rows - row : REDUCE_ROWS;
        for (uint32_t lane = 0; lane < width; lane += 64) {
            const uint32_t mask = width - lane < 64 ? width - lane : 64;
            WholeReduceMax(columnMax, values[row * stride + lane], mask, count,
                           1, 1, stride / 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            Max(rowMax[row], rowMax[row], columnMax, count);
            PipeBarrier<PIPE_V>();
        }
    }
}

template <typename T, bool TA, bool TB, typename MM>
__aicore__ inline void IterateProduce(AscendC::TPipe& pipe, MM& mm, GM_ADDR a, GM_ADDR b,
                                      GM_ADDR scratch, uint64_t batches, uint32_t m,
                                      uint32_t n, uint32_t k, IteratePlan iterative)
{
    using namespace AscendC;
    (void)batches;
    const StreamPlan plan = iterative.stream;
    TQue<TPosition::VECIN, 1> input;
    TQue<TPosition::VECOUT, 1> output;
    TBuf<TPosition::VECCALC> partial;
    pipe.InitBuffer(input, 1, iterative.baseM * iterative.baseN * sizeof(float));
    pipe.InitBuffer(output, 1, plan.tileM * sizeof(float));
    pipe.InitBuffer(partial, REDUCE_ROWS * sizeof(float));
    auto columnMax = partial.Get<float>();
    PartialSumWriter writer;
    if (plan.reduction.mode && plan.splits == 1) writer.Init(pipe, plan.tileM);
    GlobalTensor<T> aGm, bGm;
    GlobalTensor<float> partialGm;
    aGm.SetGlobalBuffer((__gm__ T*)a);
    bGm.SetGlobalBuffer((__gm__ T*)b);
    partialGm.SetGlobalBuffer((__gm__ float*)(scratch + plan.partialOffset));
    const uint32_t gridM = (m + plan.tileM - 1) / plan.tileM;
    const uint32_t gridN = (n + plan.tileN - 1) / plan.tileN;
    for (uint64_t task = GetBlockIdx(); task < plan.tasks; task += GetBlockNum()) {
        const uint32_t shard = task % plan.splits;
        const uint64_t rowTask = task / plan.splits;
        const uint64_t batch = rowTask / gridM;
        const uint32_t row = (rowTask % gridM) * plan.tileM;
        const uint32_t rows = m - row < plan.tileM ? m - row : plan.tileM;
        const uint32_t first = gridN * shard / plan.splits * plan.tileN;
        const uint32_t boundary = gridN * (shard + 1) / plan.splits * plan.tileN;
        const uint32_t last = boundary < n ? boundary : n;
        const uint32_t width = last - first;
        auto rowMax = output.AllocTensor<float>();
        Duplicate(rowMax, -3.402823466e+38F, plan.tileM);
        PipeBarrier<PIPE_V>();
        // One configuration and one End for the whole owner. The SDK advances
        // input tile offsets internally; every yielded C tile includes full K.
        mm.SetOrgShape(m, n, k);
        mm.SetSingleShape(rows, width, k);
        mm.SetTensorA(aGm[batch * m * k + (TA ? row : uint64_t(row) * k)], TA);
        mm.SetTensorB(bGm[batch * k * n + (TB ? uint64_t(first) * k : first)], TB);
        const uint32_t roundsM = (rows + iterative.baseM - 1) / iterative.baseM;
        uint32_t round = 0;
        while (mm.template Iterate<true>()) {
            auto values = input.AllocTensor<float>();
            mm.template GetTensorC<true>(values, 0, true);
            input.EnQue(values);
            values = input.DeQue<float>();
            // Host fixes FIRSTM. Restore both coordinates from the accepted
            // SDK inner tile, never from the outer scheduling tile.
            const uint32_t localRow = (round % roundsM) * iterative.baseM;
            const uint32_t localCol = (round / roundsM) * iterative.baseN;
            const uint32_t validRows = rows - localRow < iterative.baseM ? rows - localRow : iterative.baseM;
            const uint32_t validCols = width - localCol < iterative.baseN ? width - localCol : iterative.baseN;
            ConsumeLocalC(values, columnMax, rowMax[localRow], validRows, validCols, validCols);
            input.FreeTensor(values);
            ++round;
        }
        mm.End();
        output.EnQue(rowMax);
        rowMax = output.DeQue<float>();
        if (plan.reduction.mode && plan.splits == 1)
            writer.Write(rowMax, rows, partialGm[(batch * plan.reduction.segments + row / plan.tileM) * 16]);
        else DataCopy(partialGm[(batch * plan.splits + shard) * plan.rowPitch + row], rowMax, (rows + 7) / 8 * 8);
        output.FreeTensor(rowMax);
    }
}

// Device entry point: the same MIX 1:1 server and AIV barrier convention as R16.
template <typename T, bool TA, bool TB>
__schedmode__(1) __global__ __mix__(1, 1) void IterateMatmulMaxSum(
    GM_ADDR a, GM_ADDR b, GM_ADDR scratch, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, uint64_t batches, uint32_t m,
    uint32_t n, uint32_t k, IteratePlan plan)
{
    using namespace AscendC;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
    using B = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
    using C = MatmulType<TPosition::VECIN, CubeFormat::ND, float>;
    Matmul<A, B, C> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    IterateProduce<T, TA, TB>(pipe, mm, a, b, scratch, batches, m, n, k, plan);
    PipeBarrier<PIPE_ALL>();
    SyncAll<true>();
    if (plan.stream.splits > 1) {
        MergeStreamMaxima(pipe, scratch, batches, m, plan.stream);
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();
    }
    if (plan.stream.reduction.mode)
        FinalizePartialSums(pipe, scratch, y, batches, plan.stream.reduction);
    else SumRowMaxima(pipe, scratch, y, batches, m, plan.stream.rowPitch);
}

template <typename T, bool TA, bool TB>
inline void LaunchIterate(aclrtStream stream, uint8_t* a, uint8_t* b, uint8_t* scratch,
                         uint8_t* y, uint8_t* ws, AscendC::tiling::TCubeTiling tiling,
                         uint64_t batches, uint32_t m, uint32_t n, uint32_t k, IteratePlan plan)
{
    IterateMatmulMaxSum<T, TA, TB><<<plan.stream.blocks, nullptr, stream>>>(a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
}

template <typename T>
inline void DispatchIterate(bool ta, bool tb, aclrtStream stream, uint8_t* a, uint8_t* b,
                           uint8_t* scratch, uint8_t* y, uint8_t* ws, AscendC::tiling::TCubeTiling tiling,
                           uint64_t batches, uint32_t m, uint32_t n, uint32_t k, IteratePlan plan)
{
    if (ta && tb) LaunchIterate<T, true, true>(stream, a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
    else if (ta) LaunchIterate<T, true, false>(stream, a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
    else if (tb) LaunchIterate<T, false, true>(stream, a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
    else LaunchIterate<T, false, false>(stream, a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
}

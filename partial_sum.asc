// Included inside local_baseline. Eight high lanes followed by eight low lanes
// form a 64-byte record; every producer owns a complete record.
__aicore__ inline void FoldPartialTree(AscendC::LocalTensor<float> values,
    AscendC::LocalTensor<float> errors, AscendC::LocalTensor<float> work,
    uint32_t width, uint32_t workStride)
{
    using namespace AscendC;
    auto pairSum = work;
    auto virtualB = work[workStride];
    auto pairError = work[2 * workStride];
    for (uint32_t half = width / 2; half >= 8; half /= 2) {
        Add(pairSum, values, values[half], half);
        PipeBarrier<PIPE_V>();
        Sub(virtualB, pairSum, values, half);
        PipeBarrier<PIPE_V>();
        Sub(pairError, pairSum, virtualB, half);
        PipeBarrier<PIPE_V>();
        Sub(pairError, values, pairError, half);
        PipeBarrier<PIPE_V>();
        Sub(virtualB, values[half], virtualB, half);
        PipeBarrier<PIPE_V>();
        Add(pairError, pairError, virtualB, half);
        PipeBarrier<PIPE_V>();
        Add(pairError, pairError, errors[half], half);
        PipeBarrier<PIPE_V>();
        Add(errors, errors, pairError, half);
        PipeBarrier<PIPE_V>();
        Muls(values, pairSum, 1.0f, half);
        PipeBarrier<PIPE_V>();
    }
}

class PartialSumWriter {
public:
    __aicore__ inline PartialSumWriter() {}
    __aicore__ inline void Init(AscendC::TPipe& pipe, uint32_t rows)
    {
        capacity_ = 8;
        while (capacity_ < rows) capacity_ *= 2;
        pipe.InitBuffer(values_, 2 * capacity_ * sizeof(float));
        pipe.InitBuffer(work_, 3 * (capacity_ / 2) * sizeof(float));
        pipe.InitBuffer(output_, 1, 16 * sizeof(float));
    }
    __aicore__ inline void Write(AscendC::LocalTensor<float> maxima, uint32_t count,
                                AscendC::GlobalTensor<float> destination)
    {
        using namespace AscendC;
        auto values = values_.Get<float>();
        auto errors = values[capacity_];
        Duplicate(values, 0.0f, capacity_);
        Duplicate(errors, 0.0f, capacity_);
        PipeBarrier<PIPE_V>();
        // Copy REAL rows only: Max's negative tail sentinel is not Sum's zero.
        Muls(values, maxima, 1.0f, count);
        PipeBarrier<PIPE_V>();
        FoldPartialTree(values, errors, work_.Get<float>(), capacity_, capacity_ / 2);
        auto record = output_.AllocTensor<float>();
        Muls(record, values, 1.0f, 8);
        Muls(record[8], errors, 1.0f, 8);
        output_.EnQue(record);
        record = output_.DeQue<float>();
        DataCopy(destination, record, 16);
        output_.FreeTensor(record);
    }
private:
    uint32_t capacity_ = 0;
    AscendC::TBuf<AscendC::TPosition::VECCALC> values_, work_;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_;
};

__aicore__ inline void FinalizePartialSums(AscendC::TPipe& pipe, GM_ADDR records,
    GM_ADDR y, uint64_t batches, ReductionPlan plan)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> input;
    TBuf<TPosition::VECOUT> output;
    TBuf<TPosition::VECCALC> work;
    pipe.InitBuffer(input, 1, 2 * REDUCE_CHUNK * sizeof(float));
    pipe.InitBuffer(output, 32);
    pipe.InitBuffer(work, 3 * (REDUCE_CHUNK / 2) * sizeof(float));
    GlobalTensor<float> recordGm, yGm;
    recordGm.SetGlobalBuffer((__gm__ float*)records);
    yGm.SetGlobalBuffer((__gm__ float*)y);
    auto out = output.Get<float>();
    // Output ownership stays at 8 batches per aligned group, independent of
    // the many upstream M owners that performed the distributed tree.
    for (uint64_t first = uint64_t(GetBlockIdx()) * 8; first < batches;
         first += uint64_t(GetBlockNum()) * 8) {
        const uint32_t countB = batches - first < 8 ? batches - first : 8;
        for (uint32_t bi = 0; bi < countB; ++bi) {
            float sum = 0.0f, compensation = 0.0f;
            for (uint32_t start = 0; start < plan.segments; start += REDUCE_CHUNK / 8) {
                const uint32_t count = plan.segments - start < REDUCE_CHUNK / 8 ?
                    plan.segments - start : REDUCE_CHUNK / 8;
                auto values = input.AllocTensor<float>();
                const uint64_t offset = ((first + bi) * plan.segments + start) * 16;
                // GM byte strides split [high8,low8] records into two dense
                // UB arrays; all chunks and both source/destination bases align.
                DataCopyExtParams copy{static_cast<uint16_t>(count), 32, 32, 0, 0};
                DataCopyPadExtParams<float> padding{false, 0, 0, 0.0f};
                DataCopyPad(values, recordGm[offset], copy, padding);
                DataCopyPad(values[REDUCE_CHUNK], recordGm[offset + 8], copy, padding);
                input.EnQue(values);
                values = input.DeQue<float>();
                auto errors = values[REDUCE_CHUNK];
                uint32_t width = 8;
                while (width < count * 8) width *= 2;
                if (width > count * 8) {
                    Duplicate(values[count * 8], 0.0f, width - count * 8);
                    Duplicate(errors[count * 8], 0.0f, width - count * 8);
                }
                PipeBarrier<PIPE_V>();
                FoldPartialTree(values, errors, work.Get<float>(), width, REDUCE_CHUNK / 2);
                const auto vectorToScalar = pipe.FetchEventID(HardEvent::V_S);
                SetFlag<HardEvent::V_S>(vectorToScalar);
                WaitFlag<HardEvent::V_S>(vectorToScalar);
                for (uint32_t part = 0; part < 2; ++part) {
                    auto partial = part == 0 ? values : errors;
                    for (uint32_t lane = 0; lane < 8; ++lane) {
                        const float value = partial.GetValue(lane);
                        const float next = sum + value;
                        const float absSum = sum < 0.0f ? -sum : sum;
                        const float absValue = value < 0.0f ? -value : value;
                        compensation += absSum >= absValue ? (sum - next) + value : (value - next) + sum;
                        sum = next;
                    }
                }
                const auto scalarToVector = pipe.FetchEventID(HardEvent::S_V);
                SetFlag<HardEvent::S_V>(scalarToVector);
                WaitFlag<HardEvent::S_V>(scalarToVector);
                const auto scalarToCopy = pipe.FetchEventID(HardEvent::S_MTE2);
                SetFlag<HardEvent::S_MTE2>(scalarToCopy);
                WaitFlag<HardEvent::S_MTE2>(scalarToCopy);
                input.FreeTensor(values);
            }
            out.SetValue(bi, sum + compensation);
        }
        const auto scalarToCopy = pipe.FetchEventID(HardEvent::S_MTE3);
        SetFlag<HardEvent::S_MTE3>(scalarToCopy);
        WaitFlag<HardEvent::S_MTE3>(scalarToCopy);
        DataCopyExtParams copy{1, countB * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
        DataCopyPad(yGm[first], out, copy);
        const auto copyToScalar = pipe.FetchEventID(HardEvent::MTE3_S);
        SetFlag<HardEvent::MTE3_S>(copyToScalar);
        WaitFlag<HardEvent::MTE3_S>(copyToScalar);
    }
}

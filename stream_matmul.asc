// Included inside local_baseline after the shared R12 reduction helpers.
// C buffers live in GM. A single UB queue serves both slots.
__aicore__ inline void ConsumeStreamTile(AscendC::TPipe& pipe,
    AscendC::TQue<AscendC::TPosition::VECIN, 1>& input,
    AscendC::LocalTensor<float> columnMax, AscendC::LocalTensor<float> rowMax,
    AscendC::GlobalTensor<float> cGm, uint32_t rows, uint32_t width, uint32_t tileN)
{
    using namespace AscendC;
    const uint32_t paddedWidth = (width + 7) / 8 * 8;
    for (uint32_t localRow = 0; localRow < rows; localRow += REDUCE_ROWS) {
        const uint32_t count = rows - localRow < REDUCE_ROWS ? rows - localRow : REDUCE_ROWS;
        auto values = input.AllocTensor<float>();
        DataCopyExtParams copy{static_cast<uint16_t>(count), width * 4,
            (tileN - width) * 4, (REDUCE_COLS - paddedWidth) / 8, 0};
        DataCopyPadExtParams<float> padding{true, 0,
            static_cast<uint8_t>(paddedWidth - width), -3.402823466e+38F};
        DataCopyPad(values, cGm[uint64_t(localRow) * tileN], copy, padding);
        input.EnQue(values);
        values = input.DeQue<float>();
        for (uint32_t lane = 0; lane < width; lane += 64) {
            const uint32_t mask = width - lane < 64 ? width - lane : 64;
            WholeReduceMax(columnMax, values[lane], mask, count, 1, 1,
                           REDUCE_COLS / 8, ReduceOrder::ORDER_ONLY_VALUE);
            PipeBarrier<PIPE_V>();
            Max(rowMax[localRow], rowMax[localRow], columnMax, count);
            PipeBarrier<PIPE_V>();
        }
        input.FreeTensor(values);
    }
    // Queue dequeue orders MTE2->V, not MTE2->Scalar. Explicitly finish
    // ALL reads of this C slot before Scalar can submit its next overwrite.
    const auto consumed = pipe.FetchEventID(HardEvent::MTE2_S);
    SetFlag<HardEvent::MTE2_S>(consumed);
    WaitFlag<HardEvent::MTE2_S>(consumed);
}

template <typename T, bool TA, bool TB, bool Async, typename MM>
__aicore__ inline void SubmitStreamTile(MM& mm, AscendC::GlobalTensor<T> aGm,
    AscendC::GlobalTensor<T> bGm, AscendC::GlobalTensor<float> cGm,
    uint64_t batch, uint32_t row, uint32_t rows, uint32_t col,
    uint32_t m, uint32_t n, uint32_t k, uint32_t tileN)
{
    const uint32_t width = n - col < tileN ? n - col : tileN;
    // Only configure after the preceding call has completed and End has run.
    // A/B retain input strides; C has an independent compact N stride.
    mm.SetOrgShape(m, n, k, k, tileN);
    mm.SetSingleShape(rows, width, k);
    mm.SetTensorA(aGm[batch * m * k + (TA ? row : uint64_t(row) * k)], TA);
    mm.SetTensorB(bGm[batch * k * n + (TB ? uint64_t(col) * k : col)], TB);
    if (Async) mm.template IterateAll<false>(cGm, 0, false, true);
    else { mm.IterateAll(cGm); mm.End(); }
}

template <typename T, bool TA, bool TB, typename MM>
__aicore__ inline void StreamProduce(AscendC::TPipe& pipe, MM& mm, GM_ADDR a, GM_ADDR b,
                                     GM_ADDR scratch, uint64_t batches, uint32_t m,
                                     uint32_t n, uint32_t k, StreamPlan plan)
{
    using namespace AscendC;
    (void)batches; // task bounds are validated by the host plan.
    TQue<TPosition::VECIN, 1> input;
    TQue<TPosition::VECOUT, 1> output;
    TBuf<TPosition::VECCALC> partial;
    pipe.InitBuffer(input, 1, REDUCE_ROWS * REDUCE_COLS * sizeof(float));
    pipe.InitBuffer(output, 1, plan.tileM * sizeof(float));
    pipe.InitBuffer(partial, REDUCE_ROWS * sizeof(float));
    auto columnMax = partial.Get<float>();
    GlobalTensor<T> aGm, bGm;
    GlobalTensor<float> cGm, partialGm;
    aGm.SetGlobalBuffer((__gm__ T*)a);
    bGm.SetGlobalBuffer((__gm__ T*)b);
    cGm.SetGlobalBuffer((__gm__ float*)scratch + uint64_t(GetBlockIdx()) * plan.buffers * plan.cSlotElements);
    partialGm.SetGlobalBuffer((__gm__ float*)(scratch + plan.partialOffset));
    const uint32_t gridM = (m + plan.tileM - 1) / plan.tileM;
    const uint32_t gridN = (n + plan.tileN - 1) / plan.tileN;
    for (uint64_t task = GetBlockIdx(); task < plan.tasks; task += GetBlockNum()) {
        const uint32_t shard = task % plan.splits;
        const uint64_t rowTask = task / plan.splits;
        const uint64_t batch = rowTask / gridM;
        const uint32_t row = (rowTask % gridM) * plan.tileM;
        const uint32_t rows = m - row < plan.tileM ? m - row : plan.tileM;
        const uint32_t first = gridN * shard / plan.splits;
        const uint32_t last = gridN * (shard + 1) / plan.splits;
        auto rowMax = output.AllocTensor<float>();
        Duplicate(rowMax, -3.402823466e+38F, plan.tileM);
        PipeBarrier<PIPE_V>();
        if (plan.buffers == 2) {
            // Prime one result. There is at most one outstanding Matmul call.
            SubmitStreamTile<T, TA, TB, true>(mm, aGm, bGm, cGm, batch, row, rows,
                                             first * plan.tileN, m, n, k, plan.tileN);
            mm.WaitIterateAll();
            mm.End();
        }
        for (uint32_t block = first; block < last; ++block) {
            const uint32_t slot = plan.buffers == 2 ? (block - first) % 2 : 0;
            const uint32_t col = block * plan.tileN;
            const uint32_t width = n - col < plan.tileN ? n - col : plan.tileN;
            if (plan.buffers == 1) {
                SubmitStreamTile<T, TA, TB, false>(mm, aGm, bGm, cGm, batch, row, rows,
                                                  col, m, n, k, plan.tileN);
            } else if (block + 1 < last) {
                // Produce t+1 while Vector consumes t. The alternate slot's
                // previous MTE2 reads completed before its earlier reuse fence.
                SubmitStreamTile<T, TA, TB, true>(mm, aGm, bGm,
                    cGm[uint64_t(1 - slot) * plan.cSlotElements], batch, row, rows,
                    (block + 1) * plan.tileN, m, n, k, plan.tileN);
            }
            ConsumeStreamTile(pipe, input, columnMax, rowMax,
                cGm[uint64_t(slot) * plan.cSlotElements], rows, width, plan.tileN);
            if (plan.buffers == 2 && block + 1 < last) {
                mm.WaitIterateAll();
                mm.End();
            }
        }
        // No asynchronous work survives the task boundary or global barrier.
        output.EnQue(rowMax);
        rowMax = output.DeQue<float>();
        // tileM is 16-aligned; every task owns these whole 32-byte blocks.
        DataCopy(partialGm[(batch * plan.splits + shard) * plan.rowPitch + row], rowMax, (rows + 7) / 8 * 8);
        output.FreeTensor(rowMax);
    }
}

__aicore__ inline void MergeStreamMaxima(AscendC::TPipe& pipe, GM_ADDR scratch,
                                        uint64_t batches, uint32_t m, StreamPlan plan)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> input;
    TQue<TPosition::VECOUT, 1> output;
    pipe.InitBuffer(input, 1, REDUCE_ROWS * sizeof(float));
    pipe.InitBuffer(output, 1, REDUCE_ROWS * sizeof(float));
    GlobalTensor<float> partialGm, maxGm;
    partialGm.SetGlobalBuffer((__gm__ float*)(scratch + plan.partialOffset));
    maxGm.SetGlobalBuffer((__gm__ float*)(scratch + plan.maximaOffset));
    const uint32_t perBatch = plan.rowPitch / REDUCE_ROWS;
    for (uint64_t task = GetBlockIdx(); task < batches * perBatch; task += GetBlockNum()) {
        const uint64_t batch = task / perBatch;
        const uint32_t row = (task % perBatch) * REDUCE_ROWS;
        const uint32_t count = m - row < REDUCE_ROWS ? m - row : REDUCE_ROWS;
        auto best = output.AllocTensor<float>();
        Duplicate(best, -3.402823466e+38F, REDUCE_ROWS);
        PipeBarrier<PIPE_V>();
        for (uint32_t shard = 0; shard < plan.splits; ++shard) {
            auto values = input.AllocTensor<float>();
            DataCopyExtParams copy{1, count * 4, 0, 0, 0};
            DataCopyPadExtParams<float> padding{true, 0,
                static_cast<uint8_t>((count + 7) / 8 * 8 - count), -3.402823466e+38F};
            DataCopyPad(values, partialGm[(batch * plan.splits + shard) * plan.rowPitch + row], copy, padding);
            input.EnQue(values);
            values = input.DeQue<float>();
            Max(best, best, values, count);
            PipeBarrier<PIPE_V>();
            input.FreeTensor(values);
        }
        output.EnQue(best);
        best = output.DeQue<float>();
        DataCopy(maxGm[batch * plan.rowPitch + row], best, REDUCE_ROWS);
        output.FreeTensor(best);
    }
}

// Device entry point: MIX registration returns on AIC after running its server.
// Only AIV executes the producer and barriers; idle AIV still participates.
template <typename T, bool TA, bool TB>
__schedmode__(1) __global__ __mix__(1, 1) void StreamMatmulMaxSum(
    GM_ADDR a, GM_ADDR b, GM_ADDR scratch, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, uint64_t batches, uint32_t m,
    uint32_t n, uint32_t k, StreamPlan plan)
{
    using namespace AscendC;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
    using B = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, float>;
    Matmul<A, B, C> mm;
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    StreamProduce<T, TA, TB>(pipe, mm, a, b, scratch, batches, m, n, k, plan);
    PipeBarrier<PIPE_ALL>();
    SyncAll<true>();
    if (plan.splits > 1) {
        MergeStreamMaxima(pipe, scratch, batches, m, plan);
        PipeBarrier<PIPE_ALL>();
        SyncAll<true>();
    }
    SumRowMaxima(pipe, scratch + plan.maximaOffset, y, batches, m, plan.rowPitch);
}

template <typename T, bool TA, bool TB>
inline void LaunchStream(aclrtStream stream, uint8_t* a, uint8_t* b, uint8_t* scratch,
                         uint8_t* y, uint8_t* ws, AscendC::tiling::TCubeTiling tiling,
                         uint64_t batches, uint32_t m, uint32_t n, uint32_t k, StreamPlan plan)
{
    StreamMatmulMaxSum<T, TA, TB><<<plan.blocks, nullptr, stream>>>(a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
}

template <typename T>
inline void DispatchStream(bool ta, bool tb, aclrtStream stream, uint8_t* a, uint8_t* b,
                           uint8_t* scratch, uint8_t* y, uint8_t* ws, AscendC::tiling::TCubeTiling tiling,
                           uint64_t batches, uint32_t m, uint32_t n, uint32_t k, StreamPlan plan)
{
    if (ta && tb) LaunchStream<T, true, true>(stream, a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
    else if (ta) LaunchStream<T, true, false>(stream, a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
    else if (tb) LaunchStream<T, false, true>(stream, a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
    else LaunchStream<T, false, false>(stream, a, b, scratch, y, ws, tiling, batches, m, n, k, plan);
}

// Local runner: exact file sizes, guarded output, input immutability, repeats.
#include <cerrno>
#include <climits>
#include <chrono>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <fstream>
#include <iomanip>
#include <stdexcept>
#include <string>
#include <vector>
#include "acl/acl.h"
#include "data_utils.h"

struct TensorInfo { const int64_t* shape; int64_t numDims; int32_t dtype; };
struct TensorGroupInfo { const TensorInfo* tensors; int64_t numTensors; };
#include "kernel.asc"

namespace {
struct PinnedBuffer {
    void* data = nullptr;
    explicit PinnedBuffer(size_t size) { local_baseline::Check(aclrtMallocHost(&data, size), "aclrtMallocHost"); }
    ~PinnedBuffer() { if (data) aclrtFreeHost(data); }
    PinnedBuffer(const PinnedBuffer&) = delete;
    PinnedBuffer& operator=(const PinnedBuffer&) = delete;
};

int ParseInt(const char* text, int minimum, int maximum)
{
    char* end = nullptr;
    errno = 0;
    const long value = std::strtol(text, &end, 10);
    if (errno || end == text || *end || value < minimum || value > maximum)
        throw std::runtime_error("invalid numeric argument");
    return static_cast<int>(value);
}

void Require(bool condition, const std::string& message)
{
    if (!condition) throw std::runtime_error(message);
}

local_baseline::TileRequest TilePolicy(const std::string& name)
{
    if (name == "auto") return {};
    const auto split = name.find('x');
    Require(split != std::string::npos && name.find('x', split + 1) == std::string::npos,
            "CANN_MATMUL_TILE must be auto or MxN");
    const uint32_t m = ParseInt(name.substr(0, split).c_str(), 16, 256);
    const uint32_t n = ParseInt(name.substr(split + 1).c_str(), 16, 256);
    Require(m % 16 == 0 && n % 16 == 0 && name == std::to_string(m) + "x" + std::to_string(n),
            "tile dimensions must be canonical 16-aligned integers");
    return {m, n};
}

void WritePlan(std::ostream& file, const local_baseline::PreparedMatmul& actual,
               const local_baseline::ProblemDesc& p, const std::string& policy)
{
    const auto& t = actual.plan;
    file << std::setprecision(17)
         << "{\"schema_version\":2,\"planner_version\":" << local_baseline::PLANNER_VERSION
         << ",\"plan_id\":\"gm-v1-" << t.tileM << 'x' << t.tileN << "\",\"policy\":\"" << policy
         << "\",\"tile_m\":" << t.tileM << ",\"tile_n\":" << t.tileN << ",\"tasks\":" << t.tasks
         << ",\"blocks\":" << t.blocks << ",\"available_cores\":" << actual.caps.cores
         << ",\"ub_bytes\":" << actual.caps.ubBytes << ",\"ub_budget\":" << t.ubBudget
         << ",\"inner_tile\":{\"m\":" << actual.tiling.baseM << ",\"n\":" << actual.tiling.baseN
         << ",\"k\":" << actual.tiling.baseK << "}"
         << ",\"heuristic_score\":" << t.score << ",\"problem\":{\"b\":" << p.batches
         << ",\"m\":" << p.m << ",\"n\":" << p.n << ",\"k\":" << p.k
         << ",\"dtype\":\"" << (p.dtype == 1 ? "fp16" : "bf16")
         << "\",\"ta\":" << (p.ta ? "true" : "false") << ",\"tb\":" << (p.tb ? "true" : "false") << "}}";
}
} // namespace

int main(int argc, char** argv)
{
    const bool discover = argc == 5 && std::string(argv[1]) == "--list-plans";
    if (argc != 5 && argc != 7) {
        std::fprintf(stderr, "Usage: baseline_runner CASE_DIR LOGICAL_DEVICE REPEATS DUMP_SIMILARITY_0_OR_1 [WARMUP ITERATIONS]\n       baseline_runner --list-plans CASE_DIR LOGICAL_DEVICE OUTPUT_JSON\n");
        return 2;
    }
    int device = 0, result = 1;
    bool initialized = false, selected = false;
    aclrtStream stream = nullptr;
    try {
        device = ParseInt(argv[discover ? 3 : 2], 0, INT_MAX);
        const int repeats = discover ? 1 : ParseInt(argv[3], 1, 1000);
        const bool dump = !discover && ParseInt(argv[4], 0, 1) != 0;
        const int warmup = argc == 7 ? ParseInt(argv[5], 0, 1000) : 0;
        const int measured = argc == 7 ? ParseInt(argv[6], 1, 10000) : 0;
        const char* requestedTile = std::getenv("CANN_MATMUL_TILE");
        const std::string tileName = !discover && requestedTile ? requestedTile : "auto";
        const auto tilePolicy = TilePolicy(tileName);
        std::vector<double> timings;
        timings.reserve(warmup + measured);
        const std::string directory = argv[discover ? 2 : 1];
        int64_t batch, m, n, k;
        int dtype, ta, tb;
        std::ifstream metadata(directory + "/case.txt");
        Require(static_cast<bool>(metadata >> batch >> m >> n >> k >> dtype >> ta >> tb), "invalid case.txt");
        std::string extra;
        Require(!(metadata >> extra), "unexpected fields in case.txt");
        Require(batch > 0 && m > 0 && m <= 8192 && n > 0 && n <= 8192 && k > 0 && k <= 8192 &&
                (dtype == 1 || dtype == 2) && (ta == 0 || ta == 1) && (tb == 0 || tb == 1), "invalid case dimensions/dtype/layout");
        const size_t aBytes = local_baseline::Bytes(batch, m, k, 2);
        const size_t bBytes = local_baseline::Bytes(batch, k, n, 2);
        const size_t yBytes = local_baseline::Bytes(batch, 1, 1, 4);
        const uint32_t pitch = (n + 15) / 16 * 16;
        const size_t sBytes = local_baseline::Bytes(batch, m, pitch, 4);
        Require(yBytes <= SIZE_MAX - 64, "guarded output size overflow");
        local_baseline::Check(aclInit(nullptr), "aclInit");
        initialized = true;
        uint32_t devices = 0;
        local_baseline::Check(aclrtGetDeviceCount(&devices), "aclrtGetDeviceCount");
        Require(static_cast<uint32_t>(device) < devices, "ACL logical device out of range");
        local_baseline::Check(aclrtSetDevice(device), "aclrtSetDevice");
        selected = true;
        local_baseline::Check(aclrtCreateStream(&stream), "aclrtCreateStream");
        int64_t cores = 0;
        local_baseline::Check(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_CUBE_CORE_NUM, &cores), "aclrtGetDeviceInfo");
        Require(cores > 0 && cores <= 65535, "invalid Cube core count");
        const local_baseline::ProblemDesc problem{static_cast<uint64_t>(batch), static_cast<uint32_t>(m),
            static_cast<uint32_t>(n), static_cast<uint32_t>(k), static_cast<uint32_t>(dtype), ta != 0, tb != 0};
        if (discover) {
            const auto caps = local_baseline::QueryCaps(static_cast<uint32_t>(cores));
            const auto candidates = local_baseline::GenerateCandidates(problem, caps);
            std::ofstream file(argv[4]);
            file << "{\"schema_version\":2,\"auto\":";
            WritePlan(file, local_baseline::PrepareMatmul(problem, caps), problem, "auto");
            file << ",\"candidates\":[";
            for (size_t i = 0; i < candidates.count; ++i) {
                const auto& t = candidates.plans[i];
                const std::string token = std::to_string(t.tileM) + "x" + std::to_string(t.tileN);
                local_baseline::PreparedMatmul prepared;
                if (i) file << ',';
                const bool accepted = local_baseline::TryPrepare(problem, caps, {t.tileM, t.tileN}, prepared);
                file << "{\"accepted\":" << (accepted ? "true" : "false") << ",\"policy\":\"" << token << "\"";
                if (accepted) { file << ",\"plan\":"; WritePlan(file, prepared, problem, token); }
                file << '}';
            }
            file << "]}\n";
            file.close();
            Require(static_cast<bool>(file), "write candidate discovery failed");
        } else {
        local_baseline::PreparedMatmul previous{};
        std::printf("LOCAL_BASELINE ONLINE_EVALUATION=NOT_RUN\nB=%lld M=%lld N=%lld K=%lld dtype=%d transpose=%d%d cores=%lld\n",
                    static_cast<long long>(batch), static_cast<long long>(m), static_cast<long long>(n),
                    static_cast<long long>(k), dtype, ta, tb, static_cast<long long>(cores));
        std::printf("FP32 similarity workspace: %zu bytes; row pitch=%u; repeats=%d\n", sBytes, pitch, repeats);
        std::fflush(stdout);
        PinnedBuffer aHost(aBytes), bHost(bBytes), yHost(yBytes + 64);
        PinnedBuffer checkHost(std::max(aBytes, bBytes));
        PinnedBuffer diagnostic(dump ? sBytes : 4);
        local_baseline::DeviceBuffer aDevice(aBytes), bDevice(bBytes), yDevice(yBytes + 64);
        Require(ReadFile(directory + "/x1.bin", aBytes, aHost.data, aBytes), "cannot read exact x1.bin");
        Require(ReadFile(directory + "/x2.bin", bBytes, bHost.data, bBytes), "cannot read exact x2.bin");
        local_baseline::Check(aclrtMemcpy(aDevice.data, aBytes, aHost.data, aBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy x1");
        local_baseline::Check(aclrtMemcpy(bDevice.data, bBytes, bHost.data, bBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy x2");
        int64_t aShape[] = {batch, ta ? k : m, ta ? m : k};
        int64_t bShape[] = {batch, tb ? n : k, tb ? k : n};
        int64_t yShape[] = {batch};
        TensorInfo aInfo{aShape, 3, dtype}, bInfo{bShape, 3, dtype}, yInfo{yShape, 1, 0};
        TensorGroupInfo aGroup{&aInfo, 1}, bGroup{&bInfo, 1}, yGroup{&yInfo, 1};
        std::vector<uint8_t> reference(yBytes);
        for (int iteration = 0; iteration < repeats + warmup + measured; ++iteration) {
            auto* guarded = static_cast<uint8_t*>(yHost.data);
            std::memset(guarded, 0xA5, yBytes + 64);
            std::memset(guarded + 32, 0xFF, yBytes); // NaN, never a reusable previous output.
            local_baseline::Check(aclrtMemcpy(yDevice.data, yBytes + 64, yHost.data, yBytes + 64,
                                              ACL_MEMCPY_HOST_TO_DEVICE), "reset output and guards");
            auto* a = static_cast<uint8_t*>(aDevice.data);
            auto* b = static_cast<uint8_t*>(bDevice.data);
            auto* y = static_cast<uint8_t*>(yDevice.data) + 32;
            local_baseline::PreparedMatmul actual{};
            const auto start = std::chrono::steady_clock::now();
            try {
                if (dump && iteration == 0) {
                    auto similarity = local_baseline::RunKernel(a, aGroup, b, bGroup, y, yGroup,
                                                                cores, stream, ta, tb, tilePolicy, &actual);
                    local_baseline::Check(aclrtMemcpy(diagnostic.data, sBytes, similarity.data, sBytes,
                                                      ACL_MEMCPY_DEVICE_TO_HOST), "copy diagnostic similarity");
                    Require(WriteFile(directory + "/similarity.bin", diagnostic.data, sBytes), "write similarity failed");
                } else {
                    local_baseline::RunKernel(a, aGroup, b, bGroup, y, yGroup, cores, stream, ta, tb, tilePolicy, &actual);
                }
                local_baseline::Check(aclrtSynchronizeStreamWithTimeout(stream, 30000), "runner stream sync");
            } catch (...) {
                // Keep failure reporting and process control in the local runner.
                // On a stuck stream, stop before input/output owners unwind.
                if (aclrtSynchronizeStreamWithTimeout(stream, 30000) != ACL_SUCCESS) {
                    std::fprintf(stderr, "[FAIL] stream incomplete; terminating before releasing device buffers\n");
                    std::abort();
                }
                throw;
            }
            const auto stop = std::chrono::steady_clock::now();
            if (iteration == 0) {
                std::ofstream file(directory + "/matmul_plan.json");
                WritePlan(file, actual, problem, tileName);
                file << '\n'; file.close();
                Require(static_cast<bool>(file), "write actual Matmul plan failed");
                previous = actual;
            } else {
                Require(actual.plan.tileM == previous.plan.tileM && actual.plan.tileN == previous.plan.tileN &&
                        actual.plan.blocks == previous.plan.blocks && actual.plan.ubBudget == previous.plan.ubBudget &&
                        actual.tiling.baseM == previous.tiling.baseM && actual.tiling.baseN == previous.tiling.baseN &&
                        actual.tiling.baseK == previous.tiling.baseK,
                        "execution plan changed between calls");
            }
            if (iteration >= repeats)
                timings.push_back(std::chrono::duration<double, std::micro>(stop - start).count());
            local_baseline::Check(aclrtMemcpy(yHost.data, yBytes + 64, yDevice.data, yBytes + 64,
                                              ACL_MEMCPY_DEVICE_TO_HOST), "read output and guards");
            for (size_t j = 0; j < 32; ++j)
                Require(guarded[j] == 0xA5 && guarded[32 + yBytes + j] == 0xA5, "output guard overwritten");
            if (iteration == 0) std::memcpy(reference.data(), guarded + 32, yBytes);
            else Require(std::memcmp(reference.data(), guarded + 32, yBytes) == 0, "output differs between calls");
            local_baseline::Check(aclrtMemcpy(checkHost.data, aBytes, aDevice.data, aBytes, ACL_MEMCPY_DEVICE_TO_HOST), "read x1 back");
            Require(std::memcmp(aHost.data, checkHost.data, aBytes) == 0, "x1 was modified");
            local_baseline::Check(aclrtMemcpy(checkHost.data, bBytes, bDevice.data, bBytes, ACL_MEMCPY_DEVICE_TO_HOST), "read x2 back");
            Require(std::memcmp(bHost.data, checkHost.data, bBytes) == 0, "x2 was modified");
            if (iteration < repeats) {
                Require(WriteFile(directory + "/y-" + std::to_string(iteration) + ".bin", guarded + 32, yBytes), "write y failed");
                std::printf("repeat=%d completed; input bytes and output guards unchanged\n", iteration);
                std::fflush(stdout);
            }
        }
        if (measured) {
            // Timer covers run_kernel + completion only, including host tiling/alloc/free.
            // Reset, D2H, validation and file I/O are outside each timing interval.
            std::ofstream csv(directory + "/host_timings.csv");
            csv << "iteration,warmup,host_call_us\n" << std::setprecision(17);
            for (size_t i = 0; i < timings.size(); ++i)
                csv << i << ',' << (i < static_cast<size_t>(warmup) ? 1 : 0) << ',' << timings[i] << '\n';
            csv.close();
            Require(static_cast<bool>(csv), "write host timings failed");
            std::printf("host timing: warmup=%d samples=%d (NOT device Task Duration)\n", warmup, measured);
        }
        } // execution mode
        result = 0;
    } catch (const std::exception& error) {
        std::fprintf(stderr, "[FAIL] runner: %s\n", error.what());
    }
    if (stream) aclrtDestroyStream(stream);
    if (selected) aclrtResetDevice(device);
    if (initialized) aclFinalize();
    return result;
}

// Single-launch candidate with parallel row maxima and ordered FP32 summation.
// Included by the official main and local runner; no standalone entry point.
#include <algorithm>
#include <cstdint>
#include <limits>
#include <stdexcept>
#include <string>
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "lib/matmul/matmul_tiling.h"
#include "tiling/platform/platform_ascendc.h"

namespace local_baseline {
constexpr uint32_t TILE_M = 32;
constexpr uint32_t TILE_N = 64;
constexpr uint32_t REDUCE_ROWS = 32;
constexpr uint32_t REDUCE_COLS = 256;
constexpr uint32_t REDUCE_CHUNK = 1024;

__aicore__ inline void ComputeRowMaxima(AscendC::TPipe& pipe, GM_ADDR similarity, GM_ADDR maxima,
                                       uint64_t batches, uint32_t m, uint32_t n,
                                       uint32_t pitch, uint32_t rowPitch)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> input;
    TQue<TPosition::VECOUT, 1> output;
    TBuf<TPosition::VECCALC> partial;
    pipe.InitBuffer(input, 1, REDUCE_ROWS * REDUCE_COLS * sizeof(float));
    pipe.InitBuffer(output, 1, REDUCE_ROWS * sizeof(float));
    pipe.InitBuffer(partial, REDUCE_ROWS * sizeof(float));
    auto columnMax = partial.Get<float>();
    GlobalTensor<float> sGm, maxGm;
    sGm.SetGlobalBuffer((__gm__ float*)similarity);
    maxGm.SetGlobalBuffer((__gm__ float*)maxima);
    const uint64_t tilesPerBatch = rowPitch / REDUCE_ROWS;
    for (uint64_t task = GetBlockIdx(); task < batches * tilesPerBatch; task += GetBlockNum()) {
        const uint64_t batch = task / tilesPerBatch;
        const uint32_t row = static_cast<uint32_t>(task % tilesPerBatch) * REDUCE_ROWS;
        const uint32_t rows = m - row < REDUCE_ROWS ? m - row : REDUCE_ROWS;
        auto rowMax = output.AllocTensor<float>();
        // Initialize the complete output tile, including its unused final rows.
        Duplicate(rowMax, -3.402823466e+38F, REDUCE_ROWS);
        PipeBarrier<PIPE_V>();
        for (uint32_t col = 0; col < n; col += REDUCE_COLS) {
            const uint32_t width = n - col < REDUCE_COLS ? n - col : REDUCE_COLS;
            const uint32_t paddedWidth = (width + 7) / 8 * 8;
            auto values = input.AllocTensor<float>();
            // GM strides are bytes; UB strides are 32-byte blocks. Copy only
            // real columns, so unwritten similarity padding is never read.
            DataCopyExtParams copy{static_cast<uint16_t>(rows), width * 4,
                                   (pitch - width) * 4, (REDUCE_COLS - paddedWidth) / 8, 0};
            DataCopyPadExtParams<float> padding{true, 0, static_cast<uint8_t>(paddedWidth - width),
                                                -3.402823466e+38F};
            DataCopyPad(values, sGm[(batch * m + row) * pitch + col], copy, padding);
            input.EnQue(values);
            values = input.DeQue<float>();
            for (uint32_t lane = 0; lane < width; lane += 64) {
                const uint32_t mask = width - lane < 64 ? width - lane : 64;
                // One repeat per row: produce up to 32 compact maxima without
                // reading a scalar or synchronizing V->S after each row.
                WholeReduceMax(columnMax, values[lane], mask, rows, 1, 1,
                               REDUCE_COLS / 8, ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(rowMax, rowMax, columnMax, rows);
                PipeBarrier<PIPE_V>();
            }
            input.FreeTensor(values);
        }
        output.EnQue(rowMax);
        rowMax = output.DeQue<float>();
        // Every task owns a separate 128-byte region, including tail padding.
        DataCopy(maxGm[batch * rowPitch + row], rowMax, REDUCE_ROWS);
        output.FreeTensor(rowMax);
    }
}

__aicore__ inline void SumRowMaxima(AscendC::TPipe& pipe, GM_ADDR maxima, GM_ADDR y,
                                   uint64_t batches, uint32_t m, uint32_t rowPitch)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> input;
    TBuf<TPosition::VECOUT> output;
    pipe.InitBuffer(input, 1, REDUCE_CHUNK * sizeof(float));
    pipe.InitBuffer(output, 32);
    GlobalTensor<float> maxGm, yGm;
    maxGm.SetGlobalBuffer((__gm__ float*)maxima);
    yGm.SetGlobalBuffer((__gm__ float*)y);
    auto out = output.Get<float>();
    // Preserve exclusive ownership of each 32-byte final-output group.
    for (uint64_t first = static_cast<uint64_t>(GetBlockIdx()) * 8; first < batches;
         first += static_cast<uint64_t>(GetBlockNum()) * 8) {
        const uint32_t countB = batches - first < 8 ? static_cast<uint32_t>(batches - first) : 8;
        for (uint32_t bi = 0; bi < countB; ++bi) {
            float sum = 0.0f, compensation = 0.0f;
            for (uint32_t row = 0; row < m; row += REDUCE_CHUNK) {
                const uint32_t count = m - row < REDUCE_CHUNK ? m - row : REDUCE_CHUNK;
                auto values = input.AllocTensor<float>();
                DataCopy(values, maxGm[(first + bi) * rowPitch + row], (count + 7) / 8 * 8);
                input.EnQue(values);
                values = input.DeQue<float>();
                const auto copyToScalar = pipe.FetchEventID(HardEvent::MTE2_S);
                SetFlag<HardEvent::MTE2_S>(copyToScalar);
                WaitFlag<HardEvent::MTE2_S>(copyToScalar);
                // Same row order and compensation as the reference, across
                // chunk boundaries. No floating-point atomics or tree sum.
                for (uint32_t i = 0; i < count; ++i) {
                    const float corrected = values.GetValue(i) - compensation;
                    const float next = sum + corrected;
                    compensation = (next - sum) - corrected;
                    sum = next;
                }
                const auto scalarToCopy = pipe.FetchEventID(HardEvent::S_MTE2);
                SetFlag<HardEvent::S_MTE2>(scalarToCopy);
                WaitFlag<HardEvent::S_MTE2>(scalarToCopy);
                input.FreeTensor(values);
            }
            out.SetValue(bi, sum);
        }
        const auto scalarToCopy = pipe.FetchEventID(HardEvent::S_MTE3);
        SetFlag<HardEvent::S_MTE3>(scalarToCopy);
        WaitFlag<HardEvent::S_MTE3>(scalarToCopy);
        DataCopyExtParams copy{1, countB * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
        DataCopyPad(yGm[first], out, copy);
        const auto copyToScalar = pipe.FetchEventID(HardEvent::MTE3_S);
        SetFlag<HardEvent::MTE3_S>(copyToScalar);
        WaitFlag<HardEvent::MTE3_S>(copyToScalar);
    }
}

template <typename T, bool TA, bool TB>
__schedmode__(1) __global__ __mix__(1, 1) void MatmulMaxSum(
    GM_ADDR a, GM_ADDR b, GM_ADDR similarity, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, uint64_t batches,
    uint32_t m, uint32_t n, uint32_t k, uint32_t pitch)
{
    using namespace AscendC;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
    using B = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, float>;
    Matmul<A, B, C> mm;
    // The workspace attribute supplies the Matmul communication workspace.
    // In MIX mode REGIST runs the Cube server and returns on AIC; the following
    // task loop and reduction execute on AIV. One AIV controls each Cube core.
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    GlobalTensor<T> aGm, bGm;
    GlobalTensor<float> cGm;
    aGm.SetGlobalBuffer((__gm__ T*)a);
    bGm.SetGlobalBuffer((__gm__ T*)b);
    cGm.SetGlobalBuffer((__gm__ float*)similarity);
    const uint64_t rows = (m + TILE_M - 1) / TILE_M;
    const uint64_t cols = (n + TILE_N - 1) / TILE_N;
    const uint64_t perBatch = rows * cols;
    for (uint64_t task = GetBlockIdx(); task < batches * perBatch; task += GetBlockNum()) {
        const uint64_t batch = task / perBatch;
        const uint32_t row = static_cast<uint32_t>((task % perBatch) / cols) * TILE_M;
        const uint32_t col = static_cast<uint32_t>(task % cols) * TILE_N;
        const uint32_t tm = m - row < TILE_M ? m - row : TILE_M;
        const uint32_t tn = n - col < TILE_N ? n - col : TILE_N;
        const uint64_t aOffset = batch * m * k + (TA ? row : static_cast<uint64_t>(row) * k);
        const uint64_t bOffset = batch * k * n + (TB ? static_cast<uint64_t>(col) * k : col);
        const uint64_t cOffset = (batch * m + row) * pitch + col;
        // A/B retain their original physical strides. Only C has padded rows.
        mm.SetOrgShape(m, n, k, k, pitch);
        mm.SetSingleShape(tm, tn, k);
        mm.SetTensorA(aGm[aOffset], TA);
        mm.SetTensorB(bGm[bOffset], TB);
        mm.IterateAll(cGm[cOffset]);
        mm.End();
    }
    // IterateAll is synchronous: each AIV has waited for its Cube writes.
    // Every launched AIV participates, even if it owns no output batch group.
    // Do NOT use SyncAll<false>: AIC cores are running the Matmul server.
    SyncAll<true>();
    const uint32_t rowPitch = (m + REDUCE_ROWS - 1) / REDUCE_ROWS * REDUCE_ROWS;
    GM_ADDR maxima = similarity + batches * m * pitch * sizeof(float);
    ComputeRowMaxima(pipe, similarity, maxima, batches, m, n, pitch, rowPitch);
    // Include the final row-max DMA on every AIV before consumers read GM.
    // Idle AIVs must participate in this barrier too.
    PipeBarrier<PIPE_ALL>();
    SyncAll<true>();
    SumRowMaxima(pipe, maxima, y, batches, m, rowPitch);
}

inline void Check(aclError error, const char* operation)
{
    if (error != ACL_SUCCESS)
        throw std::runtime_error(std::string(operation) + ": ACL error " + std::to_string(error));
}

inline size_t Bytes(uint64_t x, uint64_t y, uint64_t z, size_t elementSize)
{
    size_t result = elementSize;
    for (uint64_t dimension : {x, y, z}) {
        if (!dimension || dimension > std::numeric_limits<size_t>::max() / result)
            throw std::runtime_error("invalid or overflowing tensor size");
        result *= static_cast<size_t>(dimension);
    }
    return result;
}

struct DeviceBuffer {
    void* data = nullptr;
    explicit DeviceBuffer(size_t bytes) { Check(aclrtMalloc(&data, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc"); }
    ~DeviceBuffer() { if (data) aclrtFree(data); }
    DeviceBuffer(const DeviceBuffer&) = delete;
    DeviceBuffer& operator=(const DeviceBuffer&) = delete;
    DeviceBuffer(DeviceBuffer&& other) noexcept : data(other.data) { other.data = nullptr; }
};

// Declared after buffers so exceptional exits also wait before freeing GM.
struct StreamCompletion {
    aclrtStream stream;
    DeviceBuffer& similarity;
    DeviceBuffer& workspace;
    bool pending = false;
    StreamCompletion(aclrtStream value, DeviceBuffer& s, DeviceBuffer& ws)
        : stream(value), similarity(s), workspace(ws) {}
    ~StreamCompletion()
    {
        if (pending && aclrtSynchronizeStreamWithTimeout(stream, 30000) != ACL_SUCCESS) {
            // Completion is unknown. Leave these allocations to context cleanup
            // instead of freeing memory that the device may still be accessing.
            similarity.data = nullptr;
            workspace.data = nullptr;
        }
    }
    void Finish() { Check(aclrtSynchronizeStreamWithTimeout(stream, 30000), "baseline stream sync"); pending = false; }
};

template <typename T, bool TA, bool TB>
inline void Launch(uint32_t blocks, aclrtStream stream, uint8_t* a, uint8_t* b,
                         uint8_t* s, uint8_t* y, uint8_t* ws, AscendC::tiling::TCubeTiling tiling,
                         uint64_t batches, uint32_t m, uint32_t n, uint32_t k, uint32_t pitch)
{
    MatmulMaxSum<T, TA, TB><<<blocks, nullptr, stream>>>(a, b, s, y, ws, tiling, batches, m, n, k, pitch);
}

template <typename T>
inline void Dispatch(bool ta, bool tb, uint32_t blocks, aclrtStream stream, uint8_t* a, uint8_t* b,
                     uint8_t* s, uint8_t* y, uint8_t* ws, AscendC::tiling::TCubeTiling tiling,
                     uint64_t batches, uint32_t m, uint32_t n, uint32_t k, uint32_t pitch)
{
    if (ta && tb) Launch<T, true, true>(blocks, stream, a, b, s, y, ws, tiling, batches, m, n, k, pitch);
    else if (ta) Launch<T, true, false>(blocks, stream, a, b, s, y, ws, tiling, batches, m, n, k, pitch);
    else if (tb) Launch<T, false, true>(blocks, stream, a, b, s, y, ws, tiling, batches, m, n, k, pitch);
    else Launch<T, false, false>(blocks, stream, a, b, s, y, ws, tiling, batches, m, n, k, pitch);
}

// The returned owner keeps scratch memory alive until the caller releases it.
// All device work is complete before a successful return.
inline DeviceBuffer RunKernel(uint8_t* x1, const TensorGroupInfo& infoX1,
                      uint8_t* x2, const TensorGroupInfo& infoX2,
                      uint8_t* y, const TensorGroupInfo& infoY,
                      int64_t availableCores, aclrtStream stream, bool ta, bool tb)
{
    if (!x1 || !x2 || !y || !stream || availableCores <= 0 || availableCores > 65535 ||
        infoX1.numTensors != 1 || infoX2.numTensors != 1 || infoY.numTensors != 1 ||
        !infoX1.tensors || !infoX2.tensors || !infoY.tensors)
        throw std::runtime_error("invalid pointers, tensor groups, stream or core count");
    const auto& a = infoX1.tensors[0];
    const auto& b = infoX2.tensors[0];
    const auto& c = infoY.tensors[0];
    if (a.numDims != 3 || b.numDims != 3 || c.numDims != 1 || !a.shape || !b.shape || !c.shape ||
        (a.dtype != 1 && a.dtype != 2) || a.dtype != b.dtype || c.dtype != 0)
        throw std::runtime_error("expected FP16/BF16 rank-3 inputs and FP32 rank-1 output");
    const int64_t batches = a.shape[0];
    const int64_t m64 = a.shape[ta ? 2 : 1];
    const int64_t k64 = a.shape[ta ? 1 : 2];
    const int64_t n64 = b.shape[tb ? 1 : 2];
    if (batches <= 0 || b.shape[0] != batches || c.shape[0] != batches || b.shape[tb ? 2 : 1] != k64 ||
        m64 < 1 || m64 > 8192 || n64 < 1 || n64 > 8192 || k64 < 1 || k64 > 8192)
        throw std::runtime_error("invalid shapes (local baseline supports M/N/K in [1,8192])");
    const uint32_t m = m64, n = n64, k = k64, pitch = (n + 15) / 16 * 16;
    Bytes(batches, m, k, 2);
    Bytes(batches, k, n, 2);
    const size_t similarityBytes = Bytes(batches, m, pitch, sizeof(float));
    const uint32_t rowPitch = (m + REDUCE_ROWS - 1) / REDUCE_ROWS * REDUCE_ROWS;
    const size_t maximaBytes = Bytes(batches, rowPitch, 1, sizeof(float));
    if (similarityBytes > std::numeric_limits<size_t>::max() - maximaBytes)
        throw std::runtime_error("similarity and row-max scratch size overflow");
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) throw std::runtime_error("cannot obtain Ascend platform information");
    matmul_tiling::MatmulApiTiling tiler(*platform);
    const auto dtype = a.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 : matmul_tiling::DataType::DT_BF16;
    tiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, ta);
    tiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, tb);
    tiler.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    tiler.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    tiler.SetOrgShape(m, n, k);
    tiler.SetShape(std::min(m, TILE_M), std::min(n, TILE_N), k);
    // Leave UB space for reduction buffers (37152 bytes) and communication.
    tiler.SetBufferSpace(-1, -1, 128 * 1024);
    tiler.EnableBias(false);
    AscendC::tiling::TCubeTiling tiling{};
    if (tiler.GetTiling(tiling) == -1) throw std::runtime_error("Matmul tiling failed");
    // Keep similarity first for the local diagnostic reader; append aligned
    // row maxima within the same allocation and lifetime.
    DeviceBuffer similarity(similarityBytes + maximaBytes);
    const size_t workspaceBytes = std::max<size_t>(platform->GetLibApiWorkSpaceSize(), 32);
    DeviceBuffer workspace(workspaceBytes);
    const uint64_t tasks = static_cast<uint64_t>(batches) * ((m + TILE_M - 1) / TILE_M) * ((n + TILE_N - 1) / TILE_N);
    const uint32_t blocks = static_cast<uint32_t>(std::min<uint64_t>(availableCores, tasks));
    StreamCompletion completion(stream, similarity, workspace);
    completion.pending = true;
    auto* s = static_cast<uint8_t*>(similarity.data);
    auto* ws = static_cast<uint8_t*>(workspace.data);
    if (a.dtype == 1) Dispatch<half>(ta, tb, blocks, stream, x1, x2, s, y, ws, tiling, batches, m, n, k, pitch);
    else Dispatch<bfloat16_t>(ta, tb, blocks, stream, x1, x2, s, y, ws, tiling, batches, m, n, k, pitch);
    completion.Finish();
    return similarity;
}
} // namespace local_baseline

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2)
{
    local_baseline::RunKernel(x1, info_x1, x2, info_x2, y, info_y,
                              availableCoreNum, stream, transposeX1, transposeX2);
}

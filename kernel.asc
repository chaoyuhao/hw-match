// Single-launch candidate: bounded Vector or streaming MIX Matmul->Max->Sum.
// Included by the official main and local runner; no standalone entry point.
#include <algorithm>
#include <cstdint>
#include <limits>
#include <stdexcept>
#include <string>
#include "matmul_plan.h"
#include "joint_plan.h"
#include "iterate_plan.h"
#include "small_vector.h"
#include "acl/acl.h"
#include "kernel_operator.h"
#include "kernel_tiling/kernel_tiling.h"
#include "lib/matmul_intf.h"
#include "lib/matmul/matmul_tiling.h"
#include "tiling/platform/platform_ascendc.h"

namespace local_baseline {
constexpr uint32_t REDUCE_ROWS = 32;
constexpr uint32_t REDUCE_COLS = 256;
constexpr uint32_t REDUCE_CHUNK = 1024;

#include "partial_sum.asc"

struct MatmulBlock {
    uint64_t batch;
    uint32_t row, col, rows, cols;
    uint64_t aOffset, bOffset, cOffset;
};

__aicore__ inline MatmulBlock GetMatmulBlock(uint64_t task, uint32_t m, uint32_t n,
                                           uint32_t k, uint32_t pitch, uint32_t tileM,
                                           uint32_t tileN, bool ta, bool tb)
{
    const uint64_t gridM = (m + tileM - 1) / tileM;
    const uint64_t gridN = (n + tileN - 1) / tileN;
    const uint64_t batch = task / (gridM * gridN);
    const uint32_t row = static_cast<uint32_t>((task % (gridM * gridN)) / gridN) * tileM;
    const uint32_t col = static_cast<uint32_t>(task % gridN) * tileN;
    return {batch, row, col, m - row < tileM ? m - row : tileM,
            n - col < tileN ? n - col : tileN,
            batch * m * k + (ta ? row : static_cast<uint64_t>(row) * k),
            batch * k * n + (tb ? static_cast<uint64_t>(col) * k : col),
            (batch * m + row) * pitch + col};
}

__aicore__ inline void ComputeRowMaxima(AscendC::TPipe& pipe, GM_ADDR similarity, GM_ADDR maxima,
                                       uint64_t batches, uint32_t m, uint32_t n,
                                       uint32_t pitch, uint32_t rowPitch, ReductionPlan reduction = {})
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> input;
    TQue<TPosition::VECOUT, 1> output;
    TBuf<TPosition::VECCALC> partial;
    pipe.InitBuffer(input, 1, REDUCE_ROWS * REDUCE_COLS * sizeof(float));
    pipe.InitBuffer(output, 1, REDUCE_ROWS * sizeof(float));
    pipe.InitBuffer(partial, REDUCE_ROWS * sizeof(float));
    auto columnMax = partial.Get<float>();
    PartialSumWriter writer;
    if (reduction.mode) writer.Init(pipe, REDUCE_ROWS);
    GlobalTensor<float> sGm, maxGm;
    sGm.SetGlobalBuffer((__gm__ float*)similarity);
    maxGm.SetGlobalBuffer((__gm__ float*)maxima);
    const uint64_t tilesPerBatch = rowPitch / REDUCE_ROWS;
    for (uint64_t task = GetBlockIdx(); task < batches * tilesPerBatch; task += GetBlockNum()) {
        const uint64_t batch = task / tilesPerBatch;
        const uint32_t row = static_cast<uint32_t>(task % tilesPerBatch) * REDUCE_ROWS;
        const uint32_t rows = m - row < REDUCE_ROWS ? m - row : REDUCE_ROWS;
        auto rowMax = output.AllocTensor<float>();
        // Initialize the complete output tile, including its unused final rows.
        Duplicate(rowMax, -3.402823466e+38F, REDUCE_ROWS);
        PipeBarrier<PIPE_V>();
        for (uint32_t col = 0; col < n; col += REDUCE_COLS) {
            const uint32_t width = n - col < REDUCE_COLS ? n - col : REDUCE_COLS;
            const uint32_t paddedWidth = (width + 7) / 8 * 8;
            auto values = input.AllocTensor<float>();
            // GM strides are bytes; UB strides are 32-byte blocks. Copy only
            // real columns, so unwritten similarity padding is never read.
            DataCopyExtParams copy{static_cast<uint16_t>(rows), width * 4,
                                   (pitch - width) * 4, (REDUCE_COLS - paddedWidth) / 8, 0};
            DataCopyPadExtParams<float> padding{true, 0, static_cast<uint8_t>(paddedWidth - width),
                                                -3.402823466e+38F};
            DataCopyPad(values, sGm[(batch * m + row) * pitch + col], copy, padding);
            input.EnQue(values);
            values = input.DeQue<float>();
            for (uint32_t lane = 0; lane < width; lane += 64) {
                const uint32_t mask = width - lane < 64 ? width - lane : 64;
                // One repeat per row: produce up to 32 compact maxima without
                // reading a scalar or synchronizing V->S after each row.
                WholeReduceMax(columnMax, values[lane], mask, rows, 1, 1,
                               REDUCE_COLS / 8, ReduceOrder::ORDER_ONLY_VALUE);
                PipeBarrier<PIPE_V>();
                Max(rowMax, rowMax, columnMax, rows);
                PipeBarrier<PIPE_V>();
            }
            input.FreeTensor(values);
        }
        output.EnQue(rowMax);
        rowMax = output.DeQue<float>();
        // Every task owns a separate 128-byte region, including tail padding.
        if (reduction.mode) writer.Write(rowMax, rows, maxGm[(batch * reduction.segments + row / REDUCE_ROWS) * 16]);
        else DataCopy(maxGm[batch * rowPitch + row], rowMax, REDUCE_ROWS);
        output.FreeTensor(rowMax);
    }
}

__aicore__ inline void SumRowMaxima(AscendC::TPipe& pipe, GM_ADDR maxima, GM_ADDR y,
                                   uint64_t batches, uint32_t m, uint32_t rowPitch)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> input;
    TBuf<TPosition::VECOUT> output;
    TBuf<TPosition::VECCALC> residual, work;
    pipe.InitBuffer(input, 1, REDUCE_CHUNK * sizeof(float));
    pipe.InitBuffer(output, 32);
    pipe.InitBuffer(residual, REDUCE_CHUNK * sizeof(float));
    pipe.InitBuffer(work, 3 * (REDUCE_CHUNK / 2) * sizeof(float));
    GlobalTensor<float> maxGm, yGm;
    maxGm.SetGlobalBuffer((__gm__ float*)maxima);
    yGm.SetGlobalBuffer((__gm__ float*)y);
    auto out = output.Get<float>();
    auto errors = residual.Get<float>();
    auto pairSum = work.Get<float>();
    auto virtualB = pairSum[REDUCE_CHUNK / 2];
    auto pairError = pairSum[REDUCE_CHUNK];
    // Preserve exclusive ownership of each 32-byte final-output group.
    for (uint64_t first = static_cast<uint64_t>(GetBlockIdx()) * 8; first < batches;
         first += static_cast<uint64_t>(GetBlockNum()) * 8) {
        const uint32_t countB = batches - first < 8 ? static_cast<uint32_t>(batches - first) : 8;
        for (uint32_t bi = 0; bi < countB; ++bi) {
            float sum = 0.0f, compensation = 0.0f;
            for (uint32_t row = 0; row < m; row += REDUCE_CHUNK) {
                const uint32_t count = m - row < REDUCE_CHUNK ? m - row : REDUCE_CHUNK;
                const uint32_t padded = (count + 7) / 8 * 8;
                uint32_t width = 8;
                while (width < count) width *= 2;
                auto values = input.AllocTensor<float>();
                // Row-max padding contains a negative sentinel, not the Sum
                // identity. Copy real rows and generate zero padding locally.
                DataCopyExtParams copy{1, count * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
                DataCopyPadExtParams<float> padding{true, 0, static_cast<uint8_t>(padded - count), 0.0f};
                DataCopyPad(values, maxGm[(first + bi) * rowPitch + row], copy, padding);
                input.EnQue(values);
                values = input.DeQue<float>();
                if (padded < width) Duplicate(values[padded], 0.0f, width - padded);
                Duplicate(errors, 0.0f, width);
                PipeBarrier<PIPE_V>();
                // Fixed compensated tree. TwoSum retains the rounding error
                // of each high-part addition; low parts travel with the tree.
                // Stop at eight lanes so all Vector source offsets stay 32B
                // aligned. No per-row Scalar reads or floating-point atomics.
                for (uint32_t half = width / 2; half >= 8; half /= 2) {
                    Add(pairSum, values, values[half], half);
                    PipeBarrier<PIPE_V>();
                    Sub(virtualB, pairSum, values, half);
                    PipeBarrier<PIPE_V>();
                    Sub(pairError, pairSum, virtualB, half);
                    PipeBarrier<PIPE_V>();
                    Sub(pairError, values, pairError, half);
                    PipeBarrier<PIPE_V>();
                    Sub(virtualB, values[half], virtualB, half);
                    PipeBarrier<PIPE_V>();
                    Add(pairError, pairError, virtualB, half);
                    PipeBarrier<PIPE_V>();
                    Add(pairError, pairError, errors[half], half);
                    PipeBarrier<PIPE_V>();
                    Add(errors, errors, pairError, half);
                    PipeBarrier<PIPE_V>();
                    Muls(values, pairSum, 1.0f, half);
                    PipeBarrier<PIPE_V>();
                }
                const auto vectorToScalar = pipe.FetchEventID(HardEvent::V_S);
                SetFlag<HardEvent::V_S>(vectorToScalar);
                WaitFlag<HardEvent::V_S>(vectorToScalar);
                const uint32_t lanes = count < 8 ? count : 8;
                const uint32_t parts = width > 8 ? 2 : 1;
                // Neumaier merge: compensation survives every lane and chunk,
                // including a small value between large cancelling partials.
                for (uint32_t part = 0; part < parts; ++part) {
                    auto partial = part == 0 ? values : errors;
                    for (uint32_t i = 0; i < lanes; ++i) {
                        const float value = partial.GetValue(i);
                        const float next = sum + value;
                        const float absSum = sum < 0.0f ? -sum : sum;
                        const float absValue = value < 0.0f ? -value : value;
                        compensation += absSum >= absValue ? (sum - next) + value : (value - next) + sum;
                        sum = next;
                    }
                }
                const auto scalarToVector = pipe.FetchEventID(HardEvent::S_V);
                SetFlag<HardEvent::S_V>(scalarToVector);
                WaitFlag<HardEvent::S_V>(scalarToVector);
                const auto scalarToCopy = pipe.FetchEventID(HardEvent::S_MTE2);
                SetFlag<HardEvent::S_MTE2>(scalarToCopy);
                WaitFlag<HardEvent::S_MTE2>(scalarToCopy);
                input.FreeTensor(values);
            }
            out.SetValue(bi, sum + compensation);
        }
        const auto scalarToCopy = pipe.FetchEventID(HardEvent::S_MTE3);
        SetFlag<HardEvent::S_MTE3>(scalarToCopy);
        WaitFlag<HardEvent::S_MTE3>(scalarToCopy);
        DataCopyExtParams copy{1, countB * static_cast<uint32_t>(sizeof(float)), 0, 0, 0};
        DataCopyPad(yGm[first], out, copy);
        const auto copyToScalar = pipe.FetchEventID(HardEvent::MTE3_S);
        SetFlag<HardEvent::MTE3_S>(copyToScalar);
        WaitFlag<HardEvent::MTE3_S>(copyToScalar);
    }
}

template <typename T, bool TA, bool TB>
__schedmode__(1) __global__ __mix__(1, 1) void MatmulMaxSum(
    GM_ADDR a, GM_ADDR b, GM_ADDR similarity, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace,
    AscendC::tiling::TCubeTiling tiling, uint64_t batches,
    uint32_t m, uint32_t n, uint32_t k, uint32_t pitch, uint32_t tileM, uint32_t tileN,
    ReductionPlan reduction)
{
    using namespace AscendC;
    TPipe pipe;
    using A = MatmulType<TPosition::GM, CubeFormat::ND, T, TA>;
    using B = MatmulType<TPosition::GM, CubeFormat::ND, T, TB>;
    using C = MatmulType<TPosition::GM, CubeFormat::ND, float>;
    Matmul<A, B, C> mm;
    // The workspace attribute supplies the Matmul communication workspace.
    // In MIX mode REGIST runs the Cube server and returns on AIC; the following
    // task loop and reduction execute on AIV. One AIV controls each Cube core.
    REGIST_MATMUL_OBJ(&pipe, GetSysWorkSpacePtr(), mm, &tiling);
    GlobalTensor<T> aGm, bGm;
    GlobalTensor<float> cGm;
    aGm.SetGlobalBuffer((__gm__ T*)a);
    bGm.SetGlobalBuffer((__gm__ T*)b);
    cGm.SetGlobalBuffer((__gm__ float*)similarity);
    const uint64_t rows = (m + tileM - 1) / tileM;
    const uint64_t cols = (n + tileN - 1) / tileN;
    const uint64_t perBatch = rows * cols;
    for (uint64_t task = GetBlockIdx(); task < batches * perBatch; task += GetBlockNum()) {
        const auto tile = GetMatmulBlock(task, m, n, k, pitch, tileM, tileN, TA, TB);
        // A/B retain their original physical strides. Only C has padded rows.
        mm.SetOrgShape(m, n, k, k, pitch);
        mm.SetSingleShape(tile.rows, tile.cols, k);
        mm.SetTensorA(aGm[tile.aOffset], TA);
        mm.SetTensorB(bGm[tile.bOffset], TB);
        mm.IterateAll(cGm[tile.cOffset]);
        mm.End();
    }
    // IterateAll is synchronous: each AIV has waited for its Cube writes.
    // Every launched AIV participates, even if it owns no output batch group.
    // Do NOT use SyncAll<false>: AIC cores are running the Matmul server.
    SyncAll<true>();
    const uint32_t rowPitch = (m + REDUCE_ROWS - 1) / REDUCE_ROWS * REDUCE_ROWS;
    GM_ADDR maxima = similarity + batches * m * pitch * sizeof(float);
    ComputeRowMaxima(pipe, similarity, maxima, batches, m, n, pitch, rowPitch, reduction);
    // Include the final row-max DMA on every AIV before consumers read GM.
    // Idle AIVs must participate in this barrier too.
    PipeBarrier<PIPE_ALL>();
    SyncAll<true>();
    if (reduction.mode) FinalizePartialSums(pipe, maxima, y, batches, reduction);
    else SumRowMaxima(pipe, maxima, y, batches, m, rowPitch);
}

#include "stream_matmul.asc"
#include "iterate_matmul.asc"

template<typename T>
__global__ __aicore__ void SmallVectorKernel(GM_ADDR a, GM_ADDR b, GM_ADDR y,
    uint64_t batches, uint32_t m, uint32_t n, uint32_t k, bool ta, SmallPlan plan)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    AscendC::TPipe pipe;
    SmallVectorOp<T> op;
    op.Init(pipe, a, b, y, batches, m, n, k, ta, plan);
    op.Process();
}

inline void Check(aclError error, const char* operation)
{
    if (error != ACL_SUCCESS)
        throw std::runtime_error(std::string(operation) + ": ACL error " + std::to_string(error));
}

inline size_t Bytes(uint64_t x, uint64_t y, uint64_t z, size_t elementSize)
{
    size_t result = elementSize;
    for (uint64_t dimension : {x, y, z}) {
        if (!dimension || dimension > std::numeric_limits<size_t>::max() / result)
            throw std::runtime_error("invalid or overflowing tensor size");
        result *= static_cast<size_t>(dimension);
    }
    return result;
}

struct DeviceBuffer {
    void* data = nullptr;
    DeviceBuffer() = default;
    explicit DeviceBuffer(size_t bytes) { Check(aclrtMalloc(&data, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "aclrtMalloc"); }
    ~DeviceBuffer() { if (data) aclrtFree(data); }
    DeviceBuffer(const DeviceBuffer&) = delete;
    DeviceBuffer& operator=(const DeviceBuffer&) = delete;
    DeviceBuffer(DeviceBuffer&& other) noexcept : data(other.data) { other.data = nullptr; }
};

// Declared after buffers so exceptional exits also wait before freeing GM.
struct StreamCompletion {
    aclrtStream stream;
    DeviceBuffer& similarity;
    DeviceBuffer& workspace;
    bool pending = false;
    StreamCompletion(aclrtStream value, DeviceBuffer& s, DeviceBuffer& ws)
        : stream(value), similarity(s), workspace(ws) {}
    ~StreamCompletion()
    {
        if (pending && aclrtSynchronizeStreamWithTimeout(stream, 30000) != ACL_SUCCESS) {
            // Completion is unknown. Leave these allocations to context cleanup
            // instead of freeing memory that the device may still be accessing.
            similarity.data = nullptr;
            workspace.data = nullptr;
        }
    }
    void Finish() { Check(aclrtSynchronizeStreamWithTimeout(stream, 30000), "baseline stream sync"); pending = false; }
};

template <typename T, bool TA, bool TB>
inline void Launch(uint32_t blocks, aclrtStream stream, uint8_t* a, uint8_t* b,
                         uint8_t* s, uint8_t* y, uint8_t* ws, AscendC::tiling::TCubeTiling tiling,
                         uint64_t batches, uint32_t m, uint32_t n, uint32_t k, uint32_t pitch,
                         uint32_t tileM, uint32_t tileN, ReductionPlan reduction)
{
    MatmulMaxSum<T, TA, TB><<<blocks, nullptr, stream>>>(a, b, s, y, ws, tiling, batches, m, n, k, pitch, tileM, tileN, reduction);
}

template <typename T>
inline void Dispatch(bool ta, bool tb, uint32_t blocks, aclrtStream stream, uint8_t* a, uint8_t* b,
                     uint8_t* s, uint8_t* y, uint8_t* ws, AscendC::tiling::TCubeTiling tiling,
                     uint64_t batches, uint32_t m, uint32_t n, uint32_t k, uint32_t pitch,
                     uint32_t tileM, uint32_t tileN, ReductionPlan reduction)
{
    if (ta && tb) Launch<T, true, true>(blocks, stream, a, b, s, y, ws, tiling, batches, m, n, k, pitch, tileM, tileN, reduction);
    else if (ta) Launch<T, true, false>(blocks, stream, a, b, s, y, ws, tiling, batches, m, n, k, pitch, tileM, tileN, reduction);
    else if (tb) Launch<T, false, true>(blocks, stream, a, b, s, y, ws, tiling, batches, m, n, k, pitch, tileM, tileN, reduction);
    else Launch<T, false, false>(blocks, stream, a, b, s, y, ws, tiling, batches, m, n, k, pitch, tileM, tileN, reduction);
}

// R17 controlled upstream experiment. false restores R16 automatic selection.
// Small and explicit local controls retain their existing behavior.
constexpr bool S2_UPSTREAM_CONTROL = false;
// R19: corrected experimental path is quarantined after S14 wrong answers.
// Default remains the online-passing R16 reference pending new online evidence.
constexpr bool ITERATE_MATMUL_MAX = false;

// Host preparation is shared by online dispatch and local discovery. No launches.
struct PreparedMatmul {
    MatmulPlan plan{};
    HardwareCaps caps{};
    AscendC::tiling::TCubeTiling tiling{};
};
struct PreparedExecution : PreparedMatmul {
    bool isStream = false, isIterate = false, fusionAttempted = false;
    bool fusionLayoutRejected = false;
    IteratePlan iterative{};
    ExecutionPlan fusionReference{};
    StreamPlan stream{};
    ReductionPlan reduction{};
    uint32_t executionPlanner = 0;
    double executionScore = 0;
    bool expansionTracked = false, expansionEnabled = false;
    uint32_t baselineReductionMode = 0;
    double baselineExecutionScore = 0;
    bool s2Attempted = false, s2Selected = false;
    ExecutionPlan s2Reference{};
};
struct ExecutionInfo : PreparedExecution {
    bool isSmall = false;
    SmallPlan small{};
};
inline HardwareCaps QueryCaps(uint32_t cores)
{
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) throw std::runtime_error("cannot obtain Ascend platform information");
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    return {cores, ub};
}
inline bool TryPrepare(const ProblemDesc& p, const HardwareCaps& caps,
                       TileRequest request, PreparedMatmul& result)
{
    result.plan = MakePlan(p, caps, request);
    result.caps = caps;
    result.tiling = {};
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) throw std::runtime_error("cannot obtain Ascend platform information");
    matmul_tiling::MatmulApiTiling tiler(*platform);
    const auto dtype = p.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 : matmul_tiling::DataType::DT_BF16;
    tiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, p.ta);
    tiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, p.tb);
    tiler.SetCType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    tiler.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    tiler.SetOrgShape(p.m, p.n, p.k);
    tiler.SetShape(std::min(p.m, request.m), std::min(p.n, request.n), p.k);
    tiler.SetBufferSpace(-1, -1, result.plan.ubBudget);
    tiler.EnableBias(false);
    return tiler.GetTiling(result.tiling) != -1;
}
inline PreparedMatmul PrepareMatmul(const ProblemDesc& p, const HardwareCaps& caps, TileRequest request = {})
{
    PreparedMatmul result;
    FindSupportedPlan(p, caps, request, [&](const MatmulPlan& candidate) {
        return TryPrepare(p, caps, {candidate.tileM, candidate.tileN}, result);
    });
    return result;
}

inline bool TryPrepareIterate(const ProblemDesc& p, const HardwareCaps& caps,
                               const ExecutionPlan& reference, IteratePlan& plan,
                               AscendC::tiling::TCubeTiling& tiling, bool& layoutRejected)
{
    // ND returns compact rows, not baseN-padded rows. WholeReduceMax needs
    // 32B-aligned row addresses/strides. Outer tileN and baseN are 16-aligned,
    // so N%8==0 makes every shard and every inner tail width legal for FP32.
    layoutRejected = p.n % 8 != 0;
    if (layoutRejected) return false;
    auto candidate = MakeIteratePlan(p, caps, reference);
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) throw std::runtime_error("cannot obtain Ascend platform information");
    matmul_tiling::MatmulApiTiling tiler(*platform);
    const auto dtype = p.dtype == 1 ? matmul_tiling::DataType::DT_FLOAT16 : matmul_tiling::DataType::DT_BF16;
    tiler.SetAType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, p.ta);
    tiler.SetBType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, dtype, p.tb);
    if (tiler.SetCType(matmul_tiling::TPosition::VECIN, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT) == -1) return false;
    tiler.SetBiasType(matmul_tiling::TPosition::GM, matmul_tiling::CubeFormat::ND, matmul_tiling::DataType::DT_FLOAT);
    tiler.SetOrgShape(p.m, p.n, p.k);
    tiler.SetShape(std::min(p.m, candidate.stream.tileM), candidate.maxColumns, p.k);
    if (tiler.SetFixSplit(candidate.baseM, candidate.baseN, -1) == -1) return false;
    if (tiler.SetTraverse(matmul_tiling::MatrixTraverse::FIRSTM) == -1) return false;
    tiler.SetBufferSpace(-1, -1, reference.matmul.ubBudget);
    tiler.EnableBias(false);
    AscendC::tiling::TCubeTiling accepted{};
    if (tiler.GetTiling(accepted) == -1 || accepted.baseK <= 0 || accepted.iterateOrder != 0 ||
        !AcceptIterateTile(candidate, p, caps, reference.matmul, accepted.baseM, accepted.baseN)) return false;
    plan = candidate;
    tiling = accepted;
    return true;
}

inline PreparedExecution PrepareExecution(const ProblemDesc& p, const HardwareCaps& caps,
                                            TileRequest request, ExecutionFamily family,
                                            ReductionPolicy sumPolicy = ReductionPolicy::Auto, bool expandReduction = true,
                                            bool s2Upstream = false, bool fuseMatmulMax = false)
{
    PreparedMatmul accepted;
    const auto baseline = FindSupportedExecutionPlan(p, caps, request, family, [&](const MatmulPlan& candidate) {
        return TryPrepare(p, caps, {candidate.tileM, candidate.tileN}, accepted);
    }, sumPolicy);
    const bool unrestricted = family == ExecutionFamily::Auto && !request.m && !request.n &&
                              sumPolicy == ReductionPolicy::Auto;
    const auto chosen = unrestricted && expandReduction ? ExpandPartialReduction(p, caps, baseline) : baseline;
    PreparedExecution result;
    result.expansionTracked = unrestricted;
    result.expansionEnabled = unrestricted && expandReduction;
    result.baselineReductionMode = baseline.reduction.mode;
    result.baselineExecutionScore = baseline.score;
    static_cast<PreparedMatmul&>(result) = accepted;
    result.isStream = chosen.family != ExecutionFamily::Gm;
    result.stream = chosen.stream;
    result.reduction = chosen.reduction;
    result.executionPlanner = (sumPolicy == ReductionPolicy::Partials || family == ExecutionFamily::Pipeline ||
        (family == ExecutionFamily::Auto && !request.m && !request.n)) ? EXECUTION_PLANNER_VERSION : 0;
    result.executionScore = chosen.score;
    if (unrestricted && expandReduction && s2Upstream) {
        result.s2Attempted = true;
        result.s2Reference = chosen;
        PreparedMatmul fixed = accepted;
        const bool sameTile = chosen.matmul.tileM == 32 && chosen.matmul.tileN == 64;
        if (sameTile || TryPrepare(p, caps, {32, 64}, fixed)) {
            ExecutionPlan control;
            control.matmul = fixed.plan;
            // Preserve R16's Rows/Partials mode. GM owns 32-row segments,
            // so rebuild its storage rather than reusing a Stream layout.
            control.reduction = MakeReductionPlan(p, 32, chosen.reduction.mode ?
                ReductionPolicy::Partials : ReductionPolicy::Rows);
            static_cast<PreparedMatmul&>(result) = fixed;
            result.isStream = false;
            result.stream = {};
            result.reduction = control.reduction;
            result.executionScore = ExecutionCost(p, control);
            result.s2Selected = true;
            // The old expansion trace described the discarded upstream plan.
            // The local report records that plan separately in s2Reference.
            result.expansionTracked = false;
        }
        // A rejected tile leaves the complete accepted R16 plan intact.
        // No device work has started; runtime errors never relaunch.
    }
    if (unrestricted && expandReduction && !s2Upstream && fuseMatmulMax) {
        result.fusionAttempted = true;
        result.fusionReference = chosen;
        IteratePlan iterative;
        AscendC::tiling::TCubeTiling tiling{};
        if (TryPrepareIterate(p, caps, chosen, iterative, tiling, result.fusionLayoutRejected)) {
            result.isIterate = result.isStream = true;
            result.iterative = iterative;
            result.stream = iterative.stream;
            result.reduction = iterative.stream.reduction;
            result.tiling = tiling;
            // The old model ranks the reference, not this different lifecycle.
            result.executionPlanner = 0;
            result.executionScore = 0;
            result.expansionTracked = false;
        }
        // SDK rejection leaves every field of the accepted R16 execution intact.
    }
    return result;
}

// The returned owner keeps scratch memory alive until the caller releases it.
// All device work is complete before a successful return.
inline DeviceBuffer RunKernel(uint8_t* x1, const TensorGroupInfo& infoX1,
                      uint8_t* x2, const TensorGroupInfo& infoX2,
                      uint8_t* y, const TensorGroupInfo& infoY,
                      int64_t availableCores, aclrtStream stream, bool ta, bool tb, TileRequest tileRequest = {},
                      ExecutionInfo* actual = nullptr, ExecutionFamily family = ExecutionFamily::Auto,
                      ReductionPolicy sumPolicy = ReductionPolicy::Auto, bool expandReduction = true,
                      bool s2Upstream = S2_UPSTREAM_CONTROL, bool fuseMatmulMax = ITERATE_MATMUL_MAX)
{
    ValidateReductionPolicy(sumPolicy);
    if (family == ExecutionFamily::Small && sumPolicy != ReductionPolicy::Auto)
        throw std::runtime_error("small family conflicts with explicit sum policy");
    if (!x1 || !x2 || !y || !stream || availableCores <= 0 || availableCores > 65535 ||
        infoX1.numTensors != 1 || infoX2.numTensors != 1 || infoY.numTensors != 1 ||
        !infoX1.tensors || !infoX2.tensors || !infoY.tensors)
        throw std::runtime_error("invalid pointers, tensor groups, stream or core count");
    const auto& a = infoX1.tensors[0];
    const auto& b = infoX2.tensors[0];
    const auto& c = infoY.tensors[0];
    if (a.numDims != 3 || b.numDims != 3 || c.numDims != 1 || !a.shape || !b.shape || !c.shape ||
        (a.dtype != 1 && a.dtype != 2) || a.dtype != b.dtype || c.dtype != 0)
        throw std::runtime_error("expected FP16/BF16 rank-3 inputs and FP32 rank-1 output");
    const int64_t batches = a.shape[0];
    const int64_t m64 = a.shape[ta ? 2 : 1];
    const int64_t k64 = a.shape[ta ? 1 : 2];
    const int64_t n64 = b.shape[tb ? 1 : 2];
    if (batches <= 0 || b.shape[0] != batches || c.shape[0] != batches || b.shape[tb ? 2 : 1] != k64 ||
        m64 < 1 || m64 > 8192 || n64 < 1 || n64 > 8192 || k64 < 1 || k64 > 8192)
        throw std::runtime_error("invalid shapes (local baseline supports M/N/K in [1,8192])");
    const uint32_t m = m64, n = n64, k = k64, pitch = (n + 15) / 16 * 16;
    const ProblemDesc problem{static_cast<uint64_t>(batches), m, n, k, static_cast<uint32_t>(a.dtype), ta, tb};
    Bytes(batches, m, k, 2);
    Bytes(batches, k, n, 2);
    Bytes(batches, 1, 1, 4);
    const auto caps = QueryCaps(static_cast<uint32_t>(availableCores));
    const auto small = MakeSmallPlan(problem, caps);
    if (sumPolicy == ReductionPolicy::Auto && SelectSmall(problem, small, tileRequest, family)) {
        // No scratch, tiler or MIX server. Exactly one launch; errors never relaunch.
        if (a.dtype == 1)
            SmallVectorKernel<half><<<small.blocks, nullptr, stream>>>(x1, x2, y, batches, m, n, k, ta, small);
        else
            SmallVectorKernel<bfloat16_t><<<small.blocks, nullptr, stream>>>(x1, x2, y, batches, m, n, k, ta, small);
        Check(aclrtSynchronizeStreamWithTimeout(stream, 30000), "small vector stream sync");
        if (actual) { *actual = {}; actual->isSmall = true; actual->small = small; actual->caps = caps; }
        return DeviceBuffer{};
    }
    const auto prepared = PrepareExecution(problem, caps, tileRequest, family, sumPolicy, expandReduction, s2Upstream, fuseMatmulMax);
    const auto& plan = prepared.plan;
    const auto& tiling = prepared.tiling;
    // Preparation resolves the upstream control and rebuilds its reduction
    // layout before allocation and the sole launch.
    const bool useStream = prepared.isStream;
    const StreamPlan streaming = prepared.stream;
    Bytes(batches, m, k, 2);
    Bytes(batches, k, n, 2);
    const size_t similarityBytes = Bytes(batches, m, pitch, sizeof(float));
    const size_t maximaBytes = prepared.reduction.bytes;
    if (similarityBytes > std::numeric_limits<size_t>::max() - maximaBytes)
        throw std::runtime_error("similarity and row-max scratch size overflow");
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    if (!platform) throw std::runtime_error("cannot obtain Ascend platform information");
    // GM fallback keeps similarity first for local diagnostics. Stream returns
    // bounded scratch only; ExecutionInfo explicitly marks that distinction.
    DeviceBuffer similarity(useStream ? streaming.scratchBytes : similarityBytes + maximaBytes);
    const size_t workspaceBytes = std::max<size_t>(platform->GetLibApiWorkSpaceSize(), 32);
    DeviceBuffer workspace(workspaceBytes);
    StreamCompletion completion(stream, similarity, workspace);
    completion.pending = true;
    auto* s = static_cast<uint8_t*>(similarity.data);
    auto* ws = static_cast<uint8_t*>(workspace.data);
    if (prepared.isIterate) {
        if (a.dtype == 1) DispatchIterate<half>(ta, tb, stream, x1, x2, s, y, ws, tiling, batches, m, n, k, prepared.iterative);
        else DispatchIterate<bfloat16_t>(ta, tb, stream, x1, x2, s, y, ws, tiling, batches, m, n, k, prepared.iterative);
    } else if (useStream) {
        if (a.dtype == 1) DispatchStream<half>(ta, tb, stream, x1, x2, s, y, ws, tiling, batches, m, n, k, streaming);
        else DispatchStream<bfloat16_t>(ta, tb, stream, x1, x2, s, y, ws, tiling, batches, m, n, k, streaming);
    } else if (a.dtype == 1) Dispatch<half>(ta, tb, plan.blocks, stream, x1, x2, s, y, ws, tiling, batches, m, n, k, pitch, plan.tileM, plan.tileN, prepared.reduction);
    else Dispatch<bfloat16_t>(ta, tb, plan.blocks, stream, x1, x2, s, y, ws, tiling, batches, m, n, k, pitch, plan.tileM, plan.tileN, prepared.reduction);
    completion.Finish();
    if (actual) { *actual = {}; static_cast<PreparedExecution&>(*actual) = prepared; }
    return similarity;
}
} // namespace local_baseline

extern "C" void run_kernel(GM_ADDR x1, const TensorGroupInfo& info_x1,
                           GM_ADDR x2, const TensorGroupInfo& info_x2,
                           GM_ADDR y, const TensorGroupInfo& info_y,
                           int64_t availableCoreNum, aclrtStream stream,
                           bool transposeX1, bool transposeX2)
{
    local_baseline::RunKernel(x1, info_x1, x2, info_x2, y, info_y,
                              availableCoreNum, stream, transposeX1, transposeX2);
}

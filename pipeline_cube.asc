// Included inside local_baseline. R23: independent physical tile pipeline.
// CANN v9 A2 classic APIs; docs/PIPELINE_CORE.md records the ownership proof.
template <typename T, bool TA, bool TB, uint32_t BM, uint32_t BN>
class PipelineCubeTile {
    AscendC::TPipe* pipe_ = nullptr;
    AscendC::TBuf<AscendC::TPosition::A1> a1_;
    AscendC::TBuf<AscendC::TPosition::B1> b1_;
    AscendC::TBuf<AscendC::TPosition::A2> a0_;
    AscendC::TBuf<AscendC::TPosition::B2> b0_;
    AscendC::TBuf<AscendC::TPosition::CO1> c0_;
    AscendC::GlobalTensor<T> a_, b_;
    uint32_t m_, n_, k_;
    PipelinePlan plan_{};
    uint64_t cachedBatch_=~uint64_t(0), panelSequence_=0;
    uint32_t cachedRow_=0;
    AscendC::TEventID l1Ready_[2], l1Free_[2], l0Ready_[2], l0Free_[2], cReady_[2], cFree_[2];

    template<AscendC::HardEvent E>
    __aicore__ inline void Fence()
    {
        auto id=pipe_->FetchEventID(E);
        AscendC::SetFlag<E>(id); AscendC::WaitFlag<E>(id);
    }
    __aicore__ inline void Clear(AscendC::LocalTensor<T> dst, uint32_t bytes)
    {
        AscendC::InitConstValueParams<T> init{};
        init.repeatTimes=1; init.blockNum=bytes/32; init.dstGap=0; init.initValue=static_cast<T>(0);
        AscendC::InitConstValue(dst,init);
        AscendC::PipeBarrier<PIPE_MTE2>();
    }
    __aicore__ inline void CopyA(uint64_t batch,uint32_t row,uint32_t rows,
        uint32_t k0,uint32_t width,uint32_t slot,bool resident)
    {
        auto dst=a1_.template Get<T>()[resident?0:uint64_t(slot)*BM*plan_.blockK];
        const uint32_t storedK=resident?plan_.paddedK:(width+15)/16*16;
        if(rows!=BM || width%16) Clear(dst,resident?plan_.a1Bytes:plan_.a1Bytes/2);
        AscendC::Nd2NzParams cp{};
        cp.ndNum=1; cp.nValue=TA?width:rows; cp.dValue=TA?rows:width;
        cp.srcDValue=TA?m_:k_; cp.dstNzC0Stride=TA?storedK:BM; cp.dstNzNStride=1;
        AscendC::DataCopy(dst,a_[batch*m_*k_+(TA?uint64_t(k0)*m_+row:uint64_t(row)*k_+k0)],cp);
    }
    __aicore__ inline void Prefetch(uint64_t batch,uint32_t row,uint32_t rows,
        uint32_t col,uint32_t cols,uint32_t k0,uint32_t slot)
    {
        using namespace AscendC;
        WaitFlag<HardEvent::MTE1_MTE2>(l1Free_[slot]);
        const uint32_t width=k_-k0<plan_.blockK?k_-k0:plan_.blockK;
        if(!plan_.residentA) CopyA(batch,row,rows,k0,width,slot,false);
        auto dst=b1_.template Get<T>()[uint64_t(slot)*BN*plan_.blockK];
        if(cols!=BN || width%16) Clear(dst,plan_.b1Bytes/2);
        Nd2NzParams cp{};
        cp.ndNum=1; cp.nValue=TB?cols:width; cp.dValue=TB?width:cols;
        cp.srcDValue=TB?k_:n_; cp.dstNzC0Stride=TB?BN:(width+15)/16*16; cp.dstNzNStride=1;
        DataCopy(dst,b_[batch*k_*n_+(TB?uint64_t(col)*k_+k0:uint64_t(k0)*n_+col)],cp);
        SetFlag<HardEvent::MTE2_MTE1>(l1Ready_[slot]);
    }
public:
    __aicore__ inline PipelineCubeTile() {}
    __aicore__ inline void Init(AscendC::TPipe& pipe,GM_ADDR a,GM_ADDR b,
        uint32_t m,uint32_t n,uint32_t k,PipelinePlan plan)
    {
        using namespace AscendC;
        pipe_=&pipe;m_=m;n_=n;k_=k;plan_=plan;
        a_.SetGlobalBuffer((__gm__ T*)a); b_.SetGlobalBuffer((__gm__ T*)b);
        pipe.InitBuffer(a1_,plan.a1Bytes);pipe.InitBuffer(b1_,plan.b1Bytes);
        pipe.InitBuffer(a0_,plan.a0Bytes);pipe.InitBuffer(b0_,plan.b0Bytes);pipe.InitBuffer(c0_,plan.c0Bytes);
        for(uint32_t s=0;s<2;++s) {
            l1Ready_[s]=pipe.template AllocEventID<HardEvent::MTE2_MTE1>();
            l1Free_[s]=pipe.template AllocEventID<HardEvent::MTE1_MTE2>();
            l0Ready_[s]=pipe.template AllocEventID<HardEvent::MTE1_M>();
            l0Free_[s]=pipe.template AllocEventID<HardEvent::M_MTE1>();
            cReady_[s]=pipe.template AllocEventID<HardEvent::M_FIX>();
            cFree_[s]=pipe.template AllocEventID<HardEvent::FIX_M>();
            SetFlag<HardEvent::MTE1_MTE2>(l1Free_[s]);
            SetFlag<HardEvent::M_MTE1>(l0Free_[s]);
            SetFlag<HardEvent::FIX_M>(cFree_[s]);
        }
    }
    __aicore__ inline void Compute(uint64_t batch,uint32_t row,uint32_t rows,
        uint32_t col,uint32_t cols,uint32_t cslot)
    {
        using namespace AscendC;
        WaitFlag<HardEvent::FIX_M>(cFree_[cslot]);
        if(plan_.residentA && (cachedBatch_!=batch || cachedRow_!=row)) {
            // A may still be read by MTE1 from the preceding owner.
            Fence<HardEvent::MTE1_MTE2>();
            CopyA(batch,row,rows,0,k_,0,true);
            cachedBatch_=batch;cachedRow_=row;
        }
        const uint32_t panels=(k_+plan_.blockK-1)/plan_.blockK;
        for(uint32_t i=0;i<2 && i<panels;++i)
            Prefetch(batch,row,rows,col,cols,i*plan_.blockK,(panelSequence_+i)%2);
        auto c0=c0_.template Get<float>()[uint64_t(cslot)*BM*BN];
        for(uint32_t i=0;i<panels;++i) {
            const uint32_t slot=(panelSequence_+i)%2,k0=i*plan_.blockK;
            const uint32_t valid=k_-k0<plan_.blockK?k_-k0:plan_.blockK;
            const uint32_t width=(valid+15)/16*16;
            WaitFlag<HardEvent::MTE2_MTE1>(l1Ready_[slot]);
            WaitFlag<HardEvent::M_MTE1>(l0Free_[slot]);
            auto a1=a1_.template Get<T>()[plan_.residentA?0:uint64_t(slot)*BM*plan_.blockK];
            auto b1=b1_.template Get<T>()[uint64_t(slot)*BN*plan_.blockK];
            auto a0=a0_.template Get<T>()[uint64_t(slot)*BM*plan_.blockK];
            auto b0=b0_.template Get<T>()[uint64_t(slot)*BN*plan_.blockK];
            const uint32_t storedK=plan_.residentA?plan_.paddedK:width;
            const uint32_t offsetK=plan_.residentA?k0:0;
            LoadData2DParams load{};
            load.repeatTimes=width/16; load.srcStride=TA?1:BM/16; load.ifTranspose=TA;
            for(uint32_t mi=0;mi<BM/16;++mi)
                LoadData(a0[mi*width*16],a1[TA?mi*storedK*16+offsetK*16:offsetK*BM+mi*256],load);
            load.repeatTimes=BN/16;load.srcStride=TB?1:width/16;load.ifTranspose=!TB;
            for(uint32_t ki=0;ki<width/16;++ki)
                LoadData(b0[ki*BN*16],b1[TB?ki*BN*16:ki*256],load);
            SetFlag<HardEvent::MTE1_MTE2>(l1Free_[slot]);
            SetFlag<HardEvent::MTE1_M>(l0Ready_[slot]);
            WaitFlag<HardEvent::MTE1_M>(l0Ready_[slot]);
            MmadParams mm{}; mm.m=BM;mm.n=BN;mm.k=width;
            mm.cmatrixInitVal=i==0; mm.cmatrixSource=false;
            Mmad(c0,a0,b0,mm);
            SetFlag<HardEvent::M_MTE1>(l0Free_[slot]);
            if(i+2<panels) Prefetch(batch,row,rows,col,cols,(i+2)*plan_.blockK,slot);
        }
        panelSequence_+=panels;
        SetFlag<HardEvent::M_FIX>(cReady_[cslot]);
    }
    __aicore__ inline void Store(uint32_t slot,AscendC::GlobalTensor<float> dst)
    {
        using namespace AscendC;
        WaitFlag<HardEvent::M_FIX>(cReady_[slot]);
        FixpipeParamsV220 fix{};fix.nSize=BN;fix.mSize=BM;
        fix.srcStride=BM;fix.dstStride=BN;fix.quantPre=QuantMode_t::NoQuant;fix.deqScalar=0;
        Fixpipe<float,float,CFG_ROW_MAJOR>(dst,c0_.template Get<float>()[uint64_t(slot)*BM*BN],fix);
        SetFlag<HardEvent::FIX_M>(cFree_[slot]);
    }
    __aicore__ inline void Finish()
    {
        using namespace AscendC;
        for(uint32_t s=0;s<2;++s) {
            WaitFlag<HardEvent::MTE1_MTE2>(l1Free_[s]);
            WaitFlag<HardEvent::M_MTE1>(l0Free_[s]);
            WaitFlag<HardEvent::FIX_M>(cFree_[s]);
            pipe_->template ReleaseEventID<HardEvent::MTE2_MTE1>(l1Ready_[s]);
            pipe_->template ReleaseEventID<HardEvent::MTE1_MTE2>(l1Free_[s]);
            pipe_->template ReleaseEventID<HardEvent::MTE1_M>(l0Ready_[s]);
            pipe_->template ReleaseEventID<HardEvent::M_MTE1>(l0Free_[s]);
            pipe_->template ReleaseEventID<HardEvent::M_FIX>(cReady_[s]);
            pipe_->template ReleaseEventID<HardEvent::FIX_M>(cFree_[s]);
        }
    }
};

// Pipeline C/V execution
template <typename T, bool TA, bool TB, uint32_t BM, uint32_t BN>
__aicore__ inline void PipelineStreamCube(AscendC::TPipe& pipe, GM_ADDR a, GM_ADDR b,
    GM_ADDR scratch, uint32_t m, uint32_t n, uint32_t k, PipelinePlan physical)
{
    using namespace AscendC;
    const auto plan=physical.stream;
    PipelineCubeTile<T,TA,TB,BM,BN> cube;
    cube.Init(pipe,a,b,m,n,k,physical);
    GlobalTensor<float> output;
    output.SetGlobalBuffer((__gm__ float*)scratch+uint64_t(GetBlockIdx())*2*plan.cSlotElements);
    const uint32_t gridM=(m+BM-1)/BM, gridN=(n+BN-1)/BN;
    uint64_t sequence=0;
    for(uint64_t task=GetBlockIdx();task<plan.tasks;task+=GetBlockNum()) {
        const uint32_t shard=task%plan.splits;
        const uint64_t owner=task/plan.splits,batch=owner/gridM;
        const uint32_t row=(owner%gridM)*BM,rows=m-row<BM?m-row:BM;
        const uint32_t first=gridN*shard/plan.splits,last=gridN*(shard+1)/plan.splits;
        for(uint32_t block=first;block<last;++block,++sequence) {
            const uint32_t slot=sequence%2,col=block*BN,cols=n-col<BN?n-col:BN;
            cube.Compute(batch,row,rows,col,cols,slot);
            // Compute into private L0C before waiting for the shared GM slot.
            if(sequence>=2) CrossCoreWaitFlag<2>(2+slot);
            cube.Store(slot,output[uint64_t(slot)*plan.cSlotElements]);
            CrossCoreSetFlag<2,PIPE_FIX>(slot);
        }
    }
    for(uint32_t slot=0;slot<2 && slot<sequence;++slot) CrossCoreWaitFlag<2>(2+slot);
    cube.Finish();
}

__aicore__ inline void PrefetchPipelineStripe(
    AscendC::TQue<AscendC::TPosition::VECIN,2>& input,
    AscendC::GlobalTensor<float> src,uint32_t count,uint32_t width,uint32_t pitch)
{
    using namespace AscendC;
    auto values=input.AllocTensor<float>();
    const uint32_t paddedWidth=(width+7)/8*8;
    DataCopyExtParams copy{static_cast<uint16_t>(count),width*4,(pitch-width)*4,(REDUCE_COLS-paddedWidth)/8,0};
    DataCopyPadExtParams<float> padding{true,0,static_cast<uint8_t>(paddedWidth-width),-3.402823466e+38F};
    DataCopyPad(values,src,copy,padding); input.EnQue(values);
}
__aicore__ inline void ConsumePipelineTile(AscendC::TPipe& pipe,
    AscendC::TQue<AscendC::TPosition::VECIN,2>& input,
    AscendC::LocalTensor<float> columnMax,AscendC::LocalTensor<float> rowMax,
    AscendC::GlobalTensor<float> cGm,uint32_t rows,uint32_t width,uint32_t tileN)
{
    using namespace AscendC;
    PrefetchPipelineStripe(input,cGm,rows<REDUCE_ROWS?rows:REDUCE_ROWS,width,tileN);
    for(uint32_t row=0;row<rows;row+=REDUCE_ROWS) {
        const uint32_t next=row+REDUCE_ROWS;
        if(next<rows) PrefetchPipelineStripe(input,cGm[uint64_t(next)*tileN],
            rows-next<REDUCE_ROWS?rows-next:REDUCE_ROWS,width,tileN);
        auto values=input.DeQue<float>();
        const uint32_t count=rows-row<REDUCE_ROWS?rows-row:REDUCE_ROWS;
        FoldMaxColumns(values,count,width);
        WholeReduceMax(columnMax,values,width<64?width:64,count,1,1,REDUCE_COLS/8,ReduceOrder::ORDER_ONLY_VALUE);
        PipeBarrier<PIPE_V>();Max(rowMax[row],rowMax[row],columnMax,count);PipeBarrier<PIPE_V>();
        input.FreeTensor(values);
    }
    const auto consumed=pipe.FetchEventID(HardEvent::MTE2_S);
    SetFlag<HardEvent::MTE2_S>(consumed);WaitFlag<HardEvent::MTE2_S>(consumed);
}

__aicore__ inline void PipelineStreamVector(AscendC::TPipe& pipe, GM_ADDR scratch,
    uint32_t m, uint32_t n, StreamPlan plan)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 2> input;
    TQue<TPosition::VECOUT, 1> output;
    TBuf<TPosition::VECCALC> partial;
    pipe.InitBuffer(input, 2, REDUCE_ROWS * REDUCE_COLS * sizeof(float));
    pipe.InitBuffer(output, 1, plan.tileM * sizeof(float));
    pipe.InitBuffer(partial, REDUCE_ROWS * sizeof(float));
    auto columnMax = partial.Get<float>();
    PartialSumWriter writer;
    if (plan.reduction.mode && plan.splits == 1) writer.Init(pipe, plan.tileM);
    GlobalTensor<float> cGm, partialGm;
    cGm.SetGlobalBuffer((__gm__ float*)scratch + uint64_t(GetBlockIdx()) * plan.buffers * plan.cSlotElements);
    partialGm.SetGlobalBuffer((__gm__ float*)(scratch + plan.partialOffset));
    const uint32_t gridM = (m + plan.tileM - 1) / plan.tileM;
    const uint32_t gridN = (n + plan.tileN - 1) / plan.tileN;
    uint64_t sequence = 0;
    for (uint64_t task = GetBlockIdx(); task < plan.tasks; task += GetBlockNum()) {
        const uint32_t shard = task % plan.splits;
        const uint64_t owner = task / plan.splits;
        const uint64_t batch = owner / gridM;
        const uint32_t row = (owner % gridM) * plan.tileM;
        const uint32_t rows = m - row < plan.tileM ? m - row : plan.tileM;
        const uint32_t first = gridN * shard / plan.splits;
        const uint32_t last = gridN * (shard + 1) / plan.splits;
        auto rowMax = output.AllocTensor<float>();
        Duplicate(rowMax, -3.402823466e+38F, plan.tileM);
        PipeBarrier<PIPE_V>();
        for (uint32_t block = first; block < last; ++block, ++sequence) {
            const uint32_t slot = sequence % plan.buffers;
            const uint32_t col = block * plan.tileN;
            const uint32_t width = n - col < plan.tileN ? n - col : plan.tileN;
            CrossCoreWaitFlag<2>(slot);
            ConsumePipelineTile(pipe, input, columnMax, rowMax,
                cGm[uint64_t(slot) * plan.cSlotElements], rows, width, plan.tileN);
            // ConsumePipelineTile fences the last MTE2 read, not just its first stripe.
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        }
        output.EnQue(rowMax);
        rowMax = output.DeQue<float>();
        if (plan.reduction.mode && plan.splits == 1)
            writer.Write(rowMax, rows, partialGm[(batch * plan.reduction.segments + row / plan.tileM) * 16]);
        else DataCopy(partialGm[(batch * plan.splits + shard) * plan.rowPitch + row], rowMax, (rows + 7) / 8 * 8);
        output.FreeTensor(rowMax);
    }
}

// Pipeline device entry: one mixed launch, no Matmul registration or SDK tiling.
template <typename T,bool TA,bool TB,uint32_t BM,uint32_t BN>
__schedmode__(1) __global__ __mix__(1,1) void PipelineMatmulMaxSum(
    GM_ADDR a,GM_ADDR b,GM_ADDR scratch,GM_ADDR y,
    uint64_t batches,uint32_t m,uint32_t n,uint32_t k,PipelinePlan physical)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
#if defined(__CCE_AICORE__) && __CCE_AICORE__ == 220
    using namespace AscendC;
    TPipe pipe;
    if ASCEND_IS_AIC { PipelineStreamCube<T,TA,TB,BM,BN>(pipe,a,b,scratch,m,n,k,physical); }
    if ASCEND_IS_AIV {
        const auto plan=physical.stream;
        PipelineStreamVector(pipe,scratch,m,n,plan);
        PipeBarrier<PIPE_ALL>();SyncAll<true>();
        if(plan.splits>1) {
            MergeStreamMaxima(pipe,scratch,batches,m,plan);
            PipeBarrier<PIPE_ALL>();SyncAll<true>();
        }
        if(plan.reduction.mode) FinalizePartialSums(pipe,scratch+plan.maximaOffset,y,batches,plan.reduction);
        else SumRowMaxima(pipe,scratch+plan.maximaOffset,y,batches,m,plan.rowPitch);
    }
#endif
}
template <typename T,bool TA,bool TB,uint32_t BM,uint32_t BN>
inline void LaunchPipelineCore(aclrtStream stream,uint8_t* a,uint8_t* b,uint8_t* scratch,uint8_t* y,
    uint64_t batches,uint32_t m,uint32_t n,uint32_t k,PipelinePlan plan)
{
    PipelineMatmulMaxSum<T,TA,TB,BM,BN><<<plan.stream.blocks,nullptr,stream>>>(a,b,scratch,y,batches,m,n,k,plan);
}
template <typename T,bool TA,bool TB,uint32_t BM>
inline void DispatchPipelineN(aclrtStream stream,uint8_t* a,uint8_t* b,uint8_t* scratch,uint8_t* y,
    uint64_t batches,uint32_t m,uint32_t n,uint32_t k,PipelinePlan plan)
{
    if(plan.stream.tileN==32) LaunchPipelineCore<T,TA,TB,BM,32>(stream,a,b,scratch,y,batches,m,n,k,plan);
    else if(plan.stream.tileN==64) LaunchPipelineCore<T,TA,TB,BM,64>(stream,a,b,scratch,y,batches,m,n,k,plan);
    else LaunchPipelineCore<T,TA,TB,BM,128>(stream,a,b,scratch,y,batches,m,n,k,plan);
}
template <typename T,bool TA,bool TB>
inline void DispatchPipelineShape(aclrtStream stream,uint8_t* a,uint8_t* b,uint8_t* scratch,uint8_t* y,
    uint64_t batches,uint32_t m,uint32_t n,uint32_t k,PipelinePlan plan)
{
    if(plan.stream.tileM==16) DispatchPipelineN<T,TA,TB,16>(stream,a,b,scratch,y,batches,m,n,k,plan);
    else if(plan.stream.tileM==32) DispatchPipelineN<T,TA,TB,32>(stream,a,b,scratch,y,batches,m,n,k,plan);
    else if(plan.stream.tileM==64) DispatchPipelineN<T,TA,TB,64>(stream,a,b,scratch,y,batches,m,n,k,plan);
    else DispatchPipelineN<T,TA,TB,128>(stream,a,b,scratch,y,batches,m,n,k,plan);
}
template <typename T>
inline void DispatchPipelineCore(bool ta,bool tb,aclrtStream stream,uint8_t* a,uint8_t* b,
    uint8_t* scratch,uint8_t* y,uint64_t batches,uint32_t m,uint32_t n,uint32_t k,PipelinePlan plan)
{
    if(ta&&tb) DispatchPipelineShape<T,true,true>(stream,a,b,scratch,y,batches,m,n,k,plan);
    else if(ta) DispatchPipelineShape<T,true,false>(stream,a,b,scratch,y,batches,m,n,k,plan);
    else if(tb) DispatchPipelineShape<T,false,true>(stream,a,b,scratch,y,batches,m,n,k,plan);
    else DispatchPipelineShape<T,false,false>(stream,a,b,scratch,y,batches,m,n,k,plan);
}

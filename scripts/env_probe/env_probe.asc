// Independent toolchain/runtime probe; not the competition implementation.
#include <cerrno>
#include <climits>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include "acl/acl.h"
#include "kernel_operator.h"

constexpr uint32_t ELEMENTS = 64;
constexpr size_t BYTES = ELEMENTS * sizeof(float);

class ProbeAdd {
public:
    __aicore__ inline ProbeAdd() {}
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR b, GM_ADDR c)
    {
        aGm.SetGlobalBuffer((__gm__ float*)a, ELEMENTS);
        bGm.SetGlobalBuffer((__gm__ float*)b, ELEMENTS);
        cGm.SetGlobalBuffer((__gm__ float*)c, ELEMENTS);
        pipe.InitBuffer(inA, 1, BYTES);
        pipe.InitBuffer(inB, 1, BYTES);
        pipe.InitBuffer(outC, 1, BYTES);
    }
    __aicore__ inline void Process()
    {
        auto a = inA.AllocTensor<float>();
        auto b = inB.AllocTensor<float>();
        AscendC::DataCopy(a, aGm, ELEMENTS);
        AscendC::DataCopy(b, bGm, ELEMENTS);
        inA.EnQue(a);
        inB.EnQue(b);
        a = inA.DeQue<float>();
        b = inB.DeQue<float>();
        auto c = outC.AllocTensor<float>();
        AscendC::Add(c, a, b, ELEMENTS);
        outC.EnQue(c);
        inA.FreeTensor(a);
        inB.FreeTensor(b);
        c = outC.DeQue<float>();
        AscendC::DataCopy(cGm, c, ELEMENTS);
        outC.FreeTensor(c);
    }
private:
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> inA, inB;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> outC;
    AscendC::GlobalTensor<float> aGm, bGm, cGm;
};

__global__ __aicore__ void environment_add(GM_ADDR a, GM_ADDR b, GM_ADDR c)
{
    ProbeAdd op;
    op.Init(a, b, c);
    op.Process();
}

#define PROBE_ACL(call) do { \
    aclError ret = (call); \
    if (ret != ACL_SUCCESS) { \
        std::fprintf(stderr, "%s failed: ACL error %d\n", #call, static_cast<int>(ret)); \
        return 1; \
    } \
} while (0)

int main(int argc, char** argv)
{
    char* end = nullptr;
    errno = 0;
    long requested = argc == 2 ? std::strtol(argv[1], &end, 10) : -1;
    if (argc != 2 || errno || end == argv[1] || *end || requested < 0 || requested > INT_MAX) {
        std::fprintf(stderr, "Usage: env_probe <ACL logical device ID>\n");
        return 2;
    }
    int32_t device = static_cast<int32_t>(requested);
    bool initialized = false, deviceSet = false;
    aclrtStream stream = nullptr;
    void *aDevice = nullptr, *bDevice = nullptr, *cDevice = nullptr;
    float* host = nullptr;
    int result = [&]() -> int {
        PROBE_ACL(aclInit(nullptr));
        initialized = true;
        uint32_t count = 0;
        PROBE_ACL(aclrtGetDeviceCount(&count));
        std::printf("ACL visible devices: %u; requested logical device: %d\n", count, device);
        if (static_cast<uint32_t>(device) >= count) {
            std::fprintf(stderr, "Logical device ID is out of range; npu-smi physical IDs may differ.\n");
            return 1;
        }
        PROBE_ACL(aclrtSetDevice(device));
        deviceSet = true;
        int64_t cubeCores = 0;
        PROBE_ACL(aclrtGetDeviceInfo(device, ACL_DEV_ATTR_CUBE_CORE_NUM, &cubeCores));
        std::printf("Cube cores reported by ACL: %lld (this probe runs vector add only)\n",
                    static_cast<long long>(cubeCores));
        PROBE_ACL(aclrtCreateStream(&stream));
        PROBE_ACL(aclrtMallocHost(reinterpret_cast<void**>(&host), 3 * BYTES));
        PROBE_ACL(aclrtMalloc(&aDevice, BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        PROBE_ACL(aclrtMalloc(&bDevice, BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        PROBE_ACL(aclrtMalloc(&cDevice, BYTES, ACL_MEM_MALLOC_HUGE_FIRST));
        for (uint32_t i = 0; i < ELEMENTS; ++i) {
            host[i] = static_cast<float>(i);
            host[ELEMENTS + i] = static_cast<float>(2 * i + 1);
            host[2 * ELEMENTS + i] = -999.0f;
        }
        PROBE_ACL(aclrtMemcpy(aDevice, BYTES, host, BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
        PROBE_ACL(aclrtMemcpy(bDevice, BYTES, host + ELEMENTS, BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
        PROBE_ACL(aclrtMemcpy(cDevice, BYTES, host + 2 * ELEMENTS, BYTES, ACL_MEMCPY_HOST_TO_DEVICE));
        environment_add<<<1, nullptr, stream>>>((GM_ADDR)aDevice, (GM_ADDR)bDevice, (GM_ADDR)cDevice);
        PROBE_ACL(aclrtSynchronizeStreamWithTimeout(stream, 3000));
        PROBE_ACL(aclrtMemcpy(host + 2 * ELEMENTS, BYTES, cDevice, BYTES, ACL_MEMCPY_DEVICE_TO_HOST));
        for (uint32_t i = 0; i < ELEMENTS; ++i) {
            float expected = static_cast<float>(3 * i + 1);
            if (host[2 * ELEMENTS + i] != expected) {
                std::fprintf(stderr, "Mismatch at %u: actual=%g expected=%g\n",
                             i, host[2 * ELEMENTS + i], expected);
                return 1;
            }
        }
        std::printf("Local vector add: all %u outputs matched exactly.\n", ELEMENTS);
        return 0;
    }();

    if (stream) aclrtDestroyStream(stream);
    if (aDevice) aclrtFree(aDevice);
    if (bDevice) aclrtFree(bDevice);
    if (cDevice) aclrtFree(cDevice);
    if (host) aclrtFreeHost(host);
    if (deviceSet) aclrtResetDevice(device);
    if (initialized) aclFinalize();
    return result;
}

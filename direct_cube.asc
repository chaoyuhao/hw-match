// Included inside local_baseline. Classic A2 Cube APIs; no Matmul server.
// Layout/API references and validation limits: docs/DIRECT_CUBE.md.
template <typename T, bool TA, bool TB>
class DirectCubeTile {
    AscendC::TPipe* pipe_ = nullptr;
    AscendC::TBuf<AscendC::TPosition::A1> a1_;
    AscendC::TBuf<AscendC::TPosition::B1> b1_;
    AscendC::TBuf<AscendC::TPosition::A2> a0_;
    AscendC::TBuf<AscendC::TPosition::B2> b0_;
    AscendC::TBuf<AscendC::TPosition::CO1> c0_;
    AscendC::GlobalTensor<T> a_, b_;
    uint32_t m_, n_, k_;
    DirectPlan plan_{};
    uint64_t cachedBatch_ = ~uint64_t(0);
    uint32_t cachedRow_ = 0;

    template <AscendC::HardEvent E>
    __aicore__ inline void Fence()
    {
        // TPipe reserves M_MTE1 IDs 0..2 on A2, even for TBuf users.
        const auto id = pipe_->FetchEventID(E);
        AscendC::SetFlag<E>(id);
        AscendC::WaitFlag<E>(id);
    }
    __aicore__ inline void CopyA(uint64_t batch, uint32_t row, uint32_t rows,
                                 uint32_t k0, uint32_t width)
    {
        AscendC::Nd2NzParams copy{};
        copy.ndNum = 1;
        copy.nValue = TA ? width : rows;
        copy.dValue = TA ? rows : width;
        copy.srcDValue = TA ? m_ : k_;
        copy.dstNzC0Stride = copy.nValue;
        copy.dstNzNStride = 1;
        AscendC::DataCopy(a1_.template Get<T>(),
            a_[batch * m_ * k_ + (TA ? uint64_t(k0) * m_ + row : uint64_t(row) * k_ + k0)], copy);
    }
public:
    __aicore__ inline DirectCubeTile() {}
    __aicore__ inline void Init(AscendC::TPipe& pipe, GM_ADDR a, GM_ADDR b,
                                uint32_t m, uint32_t n, uint32_t k, DirectPlan plan)
    {
        pipe_ = &pipe; m_ = m; n_ = n; k_ = k; plan_ = plan;
        a_.SetGlobalBuffer((__gm__ T*)a); b_.SetGlobalBuffer((__gm__ T*)b);
        pipe.InitBuffer(a1_, plan.a1Bytes); pipe.InitBuffer(b1_, plan.b1Bytes);
        pipe.InitBuffer(a0_, plan.a0Bytes); pipe.InitBuffer(b0_, plan.b0Bytes);
        pipe.InitBuffer(c0_, plan.c0Bytes);
    }
    __aicore__ inline void Compute(uint64_t batch, uint32_t row, uint32_t rows,
        uint32_t col, uint32_t cols, AscendC::GlobalTensor<float> dst, uint32_t pitch)
    {
        using namespace AscendC;
        if (plan_.residentA && (cachedBatch_ != batch || cachedRow_ != row)) {
            CopyA(batch, row, rows, 0, k_);
            cachedBatch_ = batch; cachedRow_ = row;
        }
        auto a1 = a1_.template Get<T>(); auto b1 = b1_.template Get<T>();
        auto a0 = a0_.template Get<T>(); auto b0 = b0_.template Get<T>();
        auto c0 = c0_.template Get<float>();
        for (uint32_t k0 = 0; k0 < k_; k0 += plan_.blockK) {
            const uint32_t width = k_ - k0 < plan_.blockK ? k_ - k0 : plan_.blockK;
            if (!plan_.residentA) CopyA(batch, row, rows, k0, width);
            Nd2NzParams copy{};
            copy.ndNum = 1;
            copy.nValue = TB ? cols : width;
            copy.dValue = TB ? width : cols;
            copy.srcDValue = TB ? k_ : n_;
            copy.dstNzC0Stride = copy.nValue; copy.dstNzNStride = 1;
            DataCopy(b1, b_[batch * k_ * n_ + (TB ? uint64_t(col) * k_ + k0 : uint64_t(k0) * n_ + col)], copy);
            Fence<HardEvent::MTE2_MTE1>();
            // A is zN (TA=false) or nZ (TA=true) in L1, and zZ in L0A.
            const uint32_t storedK = plan_.residentA ? k_ : width;
            const uint32_t offsetK = plan_.residentA ? k0 : 0;
            LoadData2DParams load{};
            load.repeatTimes = width / 16;
            load.srcStride = TA ? 1 : rows / 16;
            load.ifTranspose = TA;
            for (uint32_t mi = 0; mi < rows / 16; ++mi) {
                const uint32_t from = TA ? mi * storedK * 16 + offsetK * 16 : offsetK * rows + mi * 256;
                LoadData(a0[mi * width * 16], a1[from], load);
            }
            // B is zN/nZ in L1 and nZ in L0B, traversed by K-fractal.
            load.repeatTimes = cols / 16;
            load.srcStride = TB ? 1 : width / 16;
            load.ifTranspose = !TB;
            for (uint32_t ki = 0; ki < width / 16; ++ki)
                LoadData(b0[ki * cols * 16], b1[TB ? ki * cols * 16 : ki * 256], load);
            Fence<HardEvent::MTE1_M>();
            Fence<HardEvent::MTE1_MTE2>(); // release the L1 panel after all LoadData
            MmadParams mm{};
            mm.m = rows; mm.n = cols; mm.k = width;
            mm.cmatrixInitVal = k0 == 0;
            mm.cmatrixSource = false;
            Mmad(c0, a0, b0, mm);
            Fence<HardEvent::M_MTE1>(); // L0A/B cannot be overwritten before Cube reads
        }
        Fence<HardEvent::M_FIX>();
        FixpipeParamsV220 fix{};
        fix.nSize = cols; fix.mSize = rows;
        fix.srcStride = rows; fix.dstStride = pitch;
        fix.quantPre = QuantMode_t::NoQuant;
        fix.deqScalar = 0;
        Fixpipe<float, float, CFG_ROW_MAJOR>(dst, c0, fix);
        Fence<HardEvent::FIX_M>(); // one L0C version; next tile may now initialize it
    }
};

// Direct C/V execution
template <typename T, bool TA, bool TB>
__aicore__ inline void DirectStreamCube(AscendC::TPipe& pipe, GM_ADDR a, GM_ADDR b,
    GM_ADDR scratch, uint32_t m, uint32_t n, uint32_t k, StreamPlan plan, DirectPlan direct)
{
    using namespace AscendC;
    DirectCubeTile<T, TA, TB> cube;
    cube.Init(pipe, a, b, m, n, k, direct);
    GlobalTensor<float> output;
    output.SetGlobalBuffer((__gm__ float*)scratch + uint64_t(GetBlockIdx()) * plan.buffers * plan.cSlotElements);
    const uint32_t gridM = (m + plan.tileM - 1) / plan.tileM;
    const uint32_t gridN = (n + plan.tileN - 1) / plan.tileN;
    uint64_t sequence = 0;
    for (uint64_t task = GetBlockIdx(); task < plan.tasks; task += GetBlockNum()) {
        const uint32_t shard = task % plan.splits;
        const uint64_t owner = task / plan.splits;
        const uint64_t batch = owner / gridM;
        const uint32_t row = (owner % gridM) * plan.tileM;
        const uint32_t rows = m - row < plan.tileM ? m - row : plan.tileM;
        const uint32_t first = gridN * shard / plan.splits;
        const uint32_t last = gridN * (shard + 1) / plan.splits;
        for (uint32_t block = first; block < last; ++block, ++sequence) {
            const uint32_t slot = sequence % plan.buffers;
            // The first generation owns its slot without an initial FREE.
            if (sequence >= plan.buffers) CrossCoreWaitFlag<2>(2 + slot);
            const uint32_t col = block * plan.tileN;
            const uint32_t cols = n - col < plan.tileN ? n - col : plan.tileN;
            cube.Compute(batch, row, rows, col, cols, output[uint64_t(slot) * plan.cSlotElements], plan.tileN);
            CrossCoreSetFlag<2, PIPE_FIX>(slot);
        }
    }
    // Consume the last FREE for every slot ever used, including a partial ring.
    for (uint32_t slot = 0; slot < plan.buffers && slot < sequence; ++slot)
        CrossCoreWaitFlag<2>(2 + slot);
}

__aicore__ inline void DirectStreamVector(AscendC::TPipe& pipe, GM_ADDR scratch,
    uint32_t m, uint32_t n, StreamPlan plan)
{
    using namespace AscendC;
    TQue<TPosition::VECIN, 1> input;
    TQue<TPosition::VECOUT, 1> output;
    TBuf<TPosition::VECCALC> partial;
    pipe.InitBuffer(input, 1, REDUCE_ROWS * REDUCE_COLS * sizeof(float));
    pipe.InitBuffer(output, 1, plan.tileM * sizeof(float));
    pipe.InitBuffer(partial, REDUCE_ROWS * sizeof(float));
    auto columnMax = partial.Get<float>();
    PartialSumWriter writer;
    if (plan.reduction.mode && plan.splits == 1) writer.Init(pipe, plan.tileM);
    GlobalTensor<float> cGm, partialGm;
    cGm.SetGlobalBuffer((__gm__ float*)scratch + uint64_t(GetBlockIdx()) * plan.buffers * plan.cSlotElements);
    partialGm.SetGlobalBuffer((__gm__ float*)(scratch + plan.partialOffset));
    const uint32_t gridM = (m + plan.tileM - 1) / plan.tileM;
    const uint32_t gridN = (n + plan.tileN - 1) / plan.tileN;
    uint64_t sequence = 0;
    for (uint64_t task = GetBlockIdx(); task < plan.tasks; task += GetBlockNum()) {
        const uint32_t shard = task % plan.splits;
        const uint64_t owner = task / plan.splits;
        const uint64_t batch = owner / gridM;
        const uint32_t row = (owner % gridM) * plan.tileM;
        const uint32_t rows = m - row < plan.tileM ? m - row : plan.tileM;
        const uint32_t first = gridN * shard / plan.splits;
        const uint32_t last = gridN * (shard + 1) / plan.splits;
        auto rowMax = output.AllocTensor<float>();
        Duplicate(rowMax, -3.402823466e+38F, plan.tileM);
        PipeBarrier<PIPE_V>();
        for (uint32_t block = first; block < last; ++block, ++sequence) {
            const uint32_t slot = sequence % plan.buffers;
            const uint32_t col = block * plan.tileN;
            const uint32_t width = n - col < plan.tileN ? n - col : plan.tileN;
            CrossCoreWaitFlag<2>(slot);
            ConsumeStreamTile(pipe, input, columnMax, rowMax,
                cGm[uint64_t(slot) * plan.cSlotElements], rows, width, plan.tileN);
            // ConsumeStreamTile fences the last MTE2 read, not just its first stripe.
            CrossCoreSetFlag<2, PIPE_MTE2>(2 + slot);
        }
        output.EnQue(rowMax);
        rowMax = output.DeQue<float>();
        if (plan.reduction.mode && plan.splits == 1)
            writer.Write(rowMax, rows, partialGm[(batch * plan.reduction.segments + row / plan.tileM) * 16]);
        else DataCopy(partialGm[(batch * plan.splits + shard) * plan.rowPitch + row], rowMax, (rows + 7) / 8 * 8);
        output.FreeTensor(rowMax);
    }
}

// Direct device entry: AIC and AIV own independent loops, with no Matmul server.
template <typename T, bool TA, bool TB>
__schedmode__(1) __global__ __mix__(1, 1) void DirectMatmulMaxSum(
    GM_ADDR a, GM_ADDR b, GM_ADDR scratch, GM_ADDR y, __kfc_workspace__ GM_ADDR workspace,
    uint64_t batches, uint32_t m, uint32_t n, uint32_t k, uint32_t pitch,
    uint32_t tileM, uint32_t tileN, bool streaming, StreamPlan plan,
    ReductionPlan reduction, DirectPlan direct)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_MIX_AIC_1_1);
    (void)workspace;
#if defined(__CCE_AICORE__) && __CCE_AICORE__ == 220
    using namespace AscendC;
    TPipe pipe;
    if ASCEND_IS_AIC {
        if (streaming) DirectStreamCube<T, TA, TB>(pipe, a, b, scratch, m, n, k, plan, direct);
        else {
            DirectCubeTile<T, TA, TB> cube;
            cube.Init(pipe, a, b, m, n, k, direct);
            GlobalTensor<float> cGm;
            cGm.SetGlobalBuffer((__gm__ float*)scratch);
            const uint64_t tasks = batches * ((m + tileM - 1) / tileM) * ((n + tileN - 1) / tileN);
            for (uint64_t task = GetBlockIdx(); task < tasks; task += GetBlockNum()) {
                const auto tile = GetMatmulBlock(task, m, n, k, pitch, tileM, tileN, TA, TB);
                cube.Compute(tile.batch, tile.row, tile.rows, tile.col, tile.cols, cGm[tile.cOffset], pitch);
            }
            CrossCoreSetFlag<2, PIPE_FIX>(0);
        }
    }
    if ASCEND_IS_AIV {
        if (streaming) {
            DirectStreamVector(pipe, scratch, m, n, plan);
            PipeBarrier<PIPE_ALL>();
            SyncAll<true>();
            if (plan.splits > 1) {
                MergeStreamMaxima(pipe, scratch, batches, m, plan);
                PipeBarrier<PIPE_ALL>();
                SyncAll<true>();
            }
            if (reduction.mode) FinalizePartialSums(pipe, scratch + plan.maximaOffset, y, batches, reduction);
            else SumRowMaxima(pipe, scratch + plan.maximaOffset, y, batches, m, plan.rowPitch);
        } else {
            CrossCoreWaitFlag<2>(0);
            SyncAll<true>();
            const uint32_t rowPitch = (m + REDUCE_ROWS - 1) / REDUCE_ROWS * REDUCE_ROWS;
            GM_ADDR maxima = scratch + batches * m * pitch * sizeof(float);
            ComputeRowMaxima(pipe, scratch, maxima, batches, m, n, pitch, rowPitch, reduction);
            PipeBarrier<PIPE_ALL>();
            SyncAll<true>();
            if (reduction.mode) FinalizePartialSums(pipe, maxima, y, batches, reduction);
            else SumRowMaxima(pipe, maxima, y, batches, m, rowPitch);
        }
    }
#endif
}

template <typename T, bool TA, bool TB>
inline void LaunchDirect(uint32_t blocks, aclrtStream stream, uint8_t* a, uint8_t* b,
    uint8_t* scratch, uint8_t* y, uint8_t* ws, uint64_t batches, uint32_t m, uint32_t n,
    uint32_t k, uint32_t pitch, uint32_t tileM, uint32_t tileN, bool streaming,
    StreamPlan plan, ReductionPlan reduction, DirectPlan direct)
{
    DirectMatmulMaxSum<T, TA, TB><<<blocks, nullptr, stream>>>(a, b, scratch, y, ws,
        batches, m, n, k, pitch, tileM, tileN, streaming, plan, reduction, direct);
}
template <typename T>
inline void DispatchDirect(bool ta, bool tb, uint32_t blocks, aclrtStream stream,
    uint8_t* a, uint8_t* b, uint8_t* scratch, uint8_t* y, uint8_t* ws, uint64_t batches,
    uint32_t m, uint32_t n, uint32_t k, uint32_t pitch, uint32_t tileM, uint32_t tileN,
    bool streaming, StreamPlan plan, ReductionPlan reduction, DirectPlan direct)
{
    if (ta && tb) LaunchDirect<T, true, true>(blocks, stream, a, b, scratch, y, ws, batches, m, n, k, pitch, tileM, tileN, streaming, plan, reduction, direct);
    else if (ta) LaunchDirect<T, true, false>(blocks, stream, a, b, scratch, y, ws, batches, m, n, k, pitch, tileM, tileN, streaming, plan, reduction, direct);
    else if (tb) LaunchDirect<T, false, true>(blocks, stream, a, b, scratch, y, ws, batches, m, n, k, pitch, tileM, tileN, streaming, plan, reduction, direct);
    else LaunchDirect<T, false, false>(blocks, stream, a, b, scratch, y, ws, batches, m, n, k, pitch, tileM, tileN, streaming, plan, reduction, direct);
}
